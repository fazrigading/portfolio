---
import navigation from '../data/navigation.json';

const { route = '/' } = Astro.props;
const b = import.meta.env.BASE_URL;

// legacy anchor hrefs → multipage routes (navigation.json untouched)
const anchorMap: Record<string, string> = {
  '#about': 'about',
  '#experience': 'experience',
  '#research': 'research',
  '#projects': 'projects',
};
const links = navigation.map((n) => ({
  name: n.name,
  href: b + (anchorMap[n.href] ?? ''),
  key: anchorMap[n.href] ?? '/',
}));
links.push({ name: 'Blog', href: b + 'blog', key: 'blog' });
links.push({ name: 'Contact', href: b + 'contact', key: 'contact' });
---

<header class="sticky top-0 z-50 border-b border-grid bg-void/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2 text-xs sm:px-6">
    <a href={b} class="flex items-center gap-2 font-display text-lg tracking-widest text-ink">
      <span class="text-accent">▓▒░</span> DEDSEC
    </a>
    <span class="hidden items-center gap-1.5 text-dim sm:flex">
      <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-accent"></span> ONLINE
    </span>
    <div class="sysctl ml-auto flex items-center gap-2">
      <button
        id="crt-toggle"
        title="Toggle CRT overlay (also: crt <on|off>)"
        class="border border-grid px-2 py-1 uppercase tracking-wider text-dim transition-colors hover:border-accent hover:text-accent"
      >
        CRT
      </button>
      <button
        id="palette-open"
        title="Open command palette (also: CTRL+K)"
        aria-label="Open command palette"
        class="hidden border border-grid px-2 py-1 uppercase tracking-wider text-dim transition-colors hover:border-accent hover:text-accent md:inline"
      >
        CTRL+K
      </button>
    </div>
    <nav class="sysnav order-last flex w-full items-center gap-4 overflow-x-auto whitespace-nowrap py-1 md:order-none md:w-auto md:py-0">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'shrink-0 uppercase tracking-wider transition-colors hover:text-accent',
            route === l.key || (route === '/' && l.key === '/') ? 'text-accent underline underline-offset-4' : 'text-dim',
          ]}
        >
          {l.name}
        </a>
      ))}
    </nav>
    <p class="nav-hint hidden w-full font-display text-sm tracking-widest text-dim md:block">
      NAV_BAR: <span class="text-accent">OFFLINE</span> // DRIVE WITH TERMINAL `goto` OR `CTRL+K` — RUN `navbar on` TO RESTORE
    </p>
  </div>
</header>

<script is:inline>
  document.getElementById('crt-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const off = html.dataset.crt !== 'off';
    html.dataset.crt = off ? 'off' : 'on';
    try { localStorage.setItem('dedsec-crt', off ? 'off' : 'on'); } catch {}
  });
  document.getElementById('palette-open')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('dedsec:palette'));
  });
</script>
