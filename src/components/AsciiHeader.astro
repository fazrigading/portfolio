---
const { title, art, tag = '', bg = '' } = Astro.props;
---

<div class="relative overflow-hidden pb-8 pt-10">
  {bg && (
    <>
      <img src={bg} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-b from-void/60 via-void/80 to-void" aria-hidden="true"></div>
    </>
  )}
  <div class="relative">
  {tag && <p class="pb-2 text-xs uppercase tracking-[0.3em] text-dim">{tag}</p>}
  {art && (
    <pre class="hidden overflow-x-auto pb-2 font-display text-sm leading-none text-accent md:block">{art}</pre>
  )}
  <h1 class="glitch ascii-title font-display uppercase text-ink" data-text={title}>
    {title}
  </h1>
  </div>
</div>
