---
import '../styles/global.css';
import SystemBar from '../components/SystemBar.astro';
import CRTOverlay from '../components/CRTOverlay.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import LucideIcon from '../components/LucideIcon.astro';
import profile from '../data/profile.json';
import social from '../data/social.json';
import bgHome from '../assets/wallpapers/dedsec-bluecyan/official-wallpapers-blue/16_9/2_1920x1080.webp';
import bgProjects from '../assets/wallpapers/dedsec-green/official-wallpapers-green/16_9/5_1920x1080.webp';
import bgAbout from '../assets/wallpapers/dedsec-yellow/official-wallpapers-yellow/16_9/4_1920x1080.webp';
import bgExperience from '../assets/wallpapers/dedsec-magenta/official-wallpapers-magenta/16_9/3_1920x1080.webp';
import bgResearch from '../assets/wallpapers/dedsec-purple/official-wallpapers-purple/16_9/1_1920x1080.webp';
import bgBlog from '../assets/wallpapers/dedsec-red/dedsec-red-wallpaper.webp';
import bgContact from '../assets/wallpapers/dedsec-pink/dedsec-pink-green-1080p.webp';

const { route = '/', title = 'ONLINE' } = Astro.props;
const b = import.meta.env.BASE_URL;

const pageBg: Record<string, string> = {
  '/': bgHome.src,
  projects: bgProjects.src,
  about: bgAbout.src,
  experience: bgExperience.src,
  research: bgResearch.src,
  blog: bgBlog.src,
  contact: bgContact.src,
};
---

<!doctype html>
<html lang="en" data-crt="on" data-navbar="off" data-route={route}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${profile.name} — ${profile.roles.join(', ')}`} />
    <title>{title} // {profile.nameShort}_DEDSEC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=VT323&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem('dedsec-crt') === 'off') document.documentElement.dataset.crt = 'off';
        if (localStorage.getItem('dedsec-navbar') === 'on') document.documentElement.dataset.navbar = 'on';
        const a = JSON.parse(localStorage.getItem('dedsec-accent') || 'null');
        if (a) {
          document.documentElement.style.setProperty('--accent', a.accent);
          document.documentElement.style.setProperty('--accent-surface', a.surface);
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen font-term text-ink antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <img src={pageBg[route] ?? pageBg['/']} alt="" loading="eager" class="h-full w-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-b from-void/70 via-void/85 to-void"></div>
    </div>
    <SystemBar route={route} />
    <main class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-grid">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-dim sm:px-6 md:flex-row md:items-center md:justify-between">
        <p class="font-display text-sm tracking-wider">
          <span class="text-accent">SYS.LOG</span> // {profile.footer.tagline}
        </p>
        <div class="flex items-center gap-4">
          {social.socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noreferrer" title={s.name} class="text-dim transition-colors hover:text-accent">
              <LucideIcon name={s.icon} size={16} />
            </a>
          ))}
        </div>
        <p>TELEMETRY: OK // © {profile.footer.copyright}</p>
      </div>
    </footer>
    <CRTOverlay />
    <CommandPalette client:idle />
  </body>
</html>
