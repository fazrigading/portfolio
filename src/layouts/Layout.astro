---
import '../styles/global.css';
import SystemBar from '../components/SystemBar.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import { ClientRouter } from 'astro:transitions';
import LucideIcon from '../components/LucideIcon.astro';
import profile from '../data/profile.json';
import social from '../data/social.json';
import bgHome from '../assets/wallpapers/desktop/blue.webp';
import bgHomeMobile from '../assets/wallpapers/mobile/blue.webp';
import bgHomeAlt from '../assets/wallpapers/desktop/blue-alt.webp';
import bgHomeAltMobile from '../assets/wallpapers/mobile/blue-alt.webp';
import bgProjects from '../assets/wallpapers/desktop/green.webp';
import bgProjectsMobile from '../assets/wallpapers/mobile/green.webp';
import bgProjectsAlt from '../assets/wallpapers/desktop/green-alt.webp';
import bgProjectsAlt2 from '../assets/wallpapers/desktop/green-alt-2.webp';
import bgProjectsAlt2Mobile from '../assets/wallpapers/mobile/green-alt-2.webp';
import bgProjectsAlt2Mix from '../assets/wallpapers/desktop/green-alt-2-mix-magenta.webp';
import bgAbout from '../assets/wallpapers/desktop/yellow.webp';
import bgAboutMobile from '../assets/wallpapers/mobile/yellow.webp';
import bgExperience from '../assets/wallpapers/desktop/magenta.webp';
import bgExperienceMobile from '../assets/wallpapers/mobile/magenta.webp';
import bgExperienceAlt from '../assets/wallpapers/desktop/magenta-alt.webp';
import bgResearch from '../assets/wallpapers/desktop/purple.webp';
import bgResearchMobile from '../assets/wallpapers/mobile/purple.webp';
import bgResearchAlt from '../assets/wallpapers/desktop/purple-alt.webp';
import bgBlog from '../assets/wallpapers/desktop/red.webp';
import bgBlogMobile from '../assets/wallpapers/mobile/red.webp';
// No pink portrait exists — contact falls back to desktop on mobile.
import bgContact from '../assets/wallpapers/desktop/pink.webp';
import bgContactAlt from '../assets/wallpapers/desktop/pink-green.webp';

const { route = '/', title = 'ONLINE' } = Astro.props;
const b = import.meta.env.BASE_URL;

// Per-route wallpaper pools. index [0] = server-rendered default; the
// rotation script below swaps to a random non-repeating pick on every trigger.
const pageBg: Record<string, { desktop: string[]; mobile: string[] }> = {
  '/': { desktop: [bgHome.src, bgHomeAlt.src], mobile: [bgHomeMobile.src, bgHomeAltMobile.src] },
  projects: {
    desktop: [bgProjects.src, bgProjectsAlt.src, bgProjectsAlt2.src, bgProjectsAlt2Mix.src],
    mobile: [bgProjectsMobile.src, bgProjectsAlt2Mobile.src],
  },
  about: { desktop: [bgAbout.src], mobile: [bgAboutMobile.src] },
  experience: { desktop: [bgExperience.src, bgExperienceAlt.src], mobile: [bgExperienceMobile.src] },
  research: { desktop: [bgResearch.src, bgResearchAlt.src], mobile: [bgResearchMobile.src] },
  blog: { desktop: [bgBlog.src], mobile: [bgBlogMobile.src] },
  contact: { desktop: [bgContact.src, bgContactAlt.src], mobile: [] },
};
const bg = pageBg[route] ?? pageBg['/'];
---

<!doctype html>
<html lang="en" data-navbar="off" data-route={route}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${profile.name} — ${profile.roles.join(', ')}`} />
    <title>{title} // {profile.nameShort}_DEDSEC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=VT323&family=Syne:wght@700;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {/* Preload each route's default wallpaper (pool index 0) so the morph snapshots pixels; alts load on demand, then cache */}
    {[...new Set(Object.values(pageBg).map((v) => v.desktop[0]))].map((src) => (
      <link rel="preload" as="image" href={src} />
    ))}
    {[...new Set(Object.values(pageBg).map((v) => v.mobile[0]).filter(Boolean))].map((src) => (
      <link rel="preload" as="image" href={src} media="(max-width: 768px)" />
    ))}
    <ClientRouter />
    <script is:inline>
      // Random non-repeating wallpaper per route trigger (initial load + ClientRouter nav).
      function wpPick(pool, key, exclude) {
        if (!pool.length) return null;
        var candidates = (exclude && pool.length > 1) ? pool.filter(function (u) { return u !== exclude; }) : pool;
        if (!candidates.length) candidates = pool;
        var last = null;
        try { last = sessionStorage.getItem(key); } catch (e) {}
        if (last && candidates.length > 1) candidates = candidates.filter(function (u) { return u !== last; });
        if (!candidates.length) candidates = pool;
        if (candidates.length === 1) return candidates[0];
        var src = candidates[Math.floor(Math.random() * candidates.length)];
        try { sessionStorage.setItem(key, src); } catch (e) {}
        return src;
      }
      function wpRotate() {
        var root = document.getElementById('wallpaper');
        if (!root) return;
        var desktop, mobile;
        try {
          desktop = JSON.parse(root.dataset.desktopPool || '[]');
          mobile = JSON.parse(root.dataset.mobilePool || '[]');
        } catch (e) { return; }
        var isMobile = window.matchMedia('(max-width: 768px)').matches;
        var pool = isMobile && mobile.length ? mobile : desktop;
        var img = document.getElementById('wp-img');
        if (!img) return;
        var src = wpPick(pool, 'wp-last-' + (root.dataset.route || '/') + (isMobile ? '-m' : '-d'), img.getAttribute('src'));
        if (!src) return;
        var source = document.getElementById('wp-source');
        if (src === img.getAttribute('src')) {
          // single-wallpaper route (about/blog): nothing to rotate to — dip
          // to dark and back so the fade rhythm matches multi-wallpaper routes
          img.style.opacity = '0';
          setTimeout(function () { img.style.opacity = ''; }, 600);
          return;
        }
        // fade out, hold for the dip duration (even on cache hits so the
        // transition isn't retargeted mid-flight), swap, then fade back in
        img.style.opacity = '0';
        var pre = new Image();
        var swapped = false;
        var restore = function () {
          if (swapped) return;
          swapped = true;
          if (isMobile && mobile.length && source) source.setAttribute('srcset', src);
          img.setAttribute('src', src);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { img.style.opacity = ''; });
          });
        };
        pre.onload = function () { setTimeout(restore, 600); };
        pre.onerror = function () { img.style.opacity = ''; };
        pre.src = src;
      }
      function wpRotateAfterTransition() {
        // never dip while the ClientRouter crossfade is still animating
        var vt = document.viewTransition;
        if (vt && vt.finished && vt.finished.then) vt.finished.then(wpRotate);
        else wpRotate();
      }
      document.addEventListener('astro:page-load', wpRotateAfterTransition);
    </script>
    <script is:inline>
      // Re-applied on every ClientRouter swap: the incoming page's <html>
      // attributes (data-navbar="off", inline styles) overwrite these prefs.
      function applyPrefs() {
        try {
          if (localStorage.getItem('dedsec-navbar') === 'on') document.documentElement.dataset.navbar = 'on';
          const a = JSON.parse(localStorage.getItem('dedsec-accent') || 'null');
          if (a) {
            document.documentElement.style.setProperty('--accent', a.accent);
            document.documentElement.style.setProperty('--accent-surface', a.surface);
          }
        } catch {}
      }
      document.addEventListener('astro:after-swap', applyPrefs);
      applyPrefs();
    </script>
  </head>
  <body class="min-h-screen font-term text-ink antialiased">
    <div id="wallpaper" transition:name="wallpaper" class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true" data-route={route} data-desktop-pool={JSON.stringify(bg.desktop)} data-mobile-pool={JSON.stringify(bg.mobile)}>
      <picture>
        {bg.mobile[0] && <source id="wp-source" media="(max-width: 768px)" srcset={bg.mobile[0]} />}
        <img id="wp-img" src={bg.desktop[0]} alt="" loading="eager" class="h-full w-full object-cover opacity-35" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-void/40 via-void/50 to-void/80"></div>
    </div>
    <SystemBar route={route} />
    <main class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-grid">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-dim sm:px-6 md:flex-row md:items-center md:justify-between">
        <p class="font-display text-sm tracking-wider">
          <span class="text-accent">SYS.LOG</span> // {profile.footer.tagline}
        </p>
        <div class="flex items-center gap-4">
          {social.socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noreferrer" title={s.name} class="text-dim transition-colors hover:text-accent">
              <LucideIcon name={s.icon} size={16} />
            </a>
          ))}
        </div>
        <p>TELEMETRY: OK // © {profile.footer.copyright}</p>
      </div>
    </footer>
    <CommandPalette client:idle />
  </body>
</html>
