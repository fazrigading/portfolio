---
import ProLayout from '../../layouts/ProLayout.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import research from '../../data/research.json';
import social from '../../data/social.json';
import pro from '../../data/pro.json';

const b = import.meta.env.BASE_URL;
const scholar = social.scholarProfiles;
const order = { Published: 0, 'On-Review': 1, Submitted: 2 };
const papers = [...research].sort(
  (a, b2) => (order[a.status] ?? 3) - (order[b2.status] ?? 3) || b2.year - a.year
);
const q1 = papers.filter((p) => p.category === 'Scopus Q1');
---

<ProLayout title="Research" kicker="03 / Research — applied computer vision, published">
  <div class="grid gap-y-10 pt-8 sm:pt-12 lg:grid-cols-12 lg:gap-x-12">
    <div class="lg:col-span-7">
      <p class="pro-body">
        Six papers with {q1.length} in Q1 venues, all co-authored on real field data: oil palm bunches counted
        under natural lighting in East Kalimantan, Ganoderma detection in plantations, maize disease under
        variable illumination. Detection models were compared on counting accuracy and mean absolute error,
        not only on mAP.
      </p>
      <p class="pro-body mt-6">{pro.publicationsNote}</p>
    </div>
    <aside class="lg:col-span-5">
      <p class="pro-eyebrow">Profiles</p>
      <div class="mt-4">
        {
          scholar.map((s) => (
            <div class="pro-reach">
              <span class="k">{s.name}</span>
              <a href={s.href} target="_blank" rel="noreferrer" class="v pro-link inline-flex items-center gap-2">
                {s.name === 'ORCID' ? s.href.replace('https://', '') : 'Open profile'}
                <LucideIcon name="ArrowUpRight" size={16} />
              </a>
            </div>
          ))
        }
      </div>
    </aside>
  </div>

  <section class="pt-16 sm:pt-24" aria-label="Publications">
    <p class="pro-eyebrow">Publications — {papers.length}</p>
    <div class="mt-6">
      {
        papers.map((p) => (
          <article class="pro-pub">
            <div>
              <h3>
                {p.articleUrl && p.articleUrl !== '#' ? (
                  <a href={p.articleUrl} target="_blank" rel="noreferrer" class="pro-link">
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <p class="authors">{p.authors}</p>
              <p class="venue">
                {p.journal} · {p.year}
              </p>
              {p.abstract && <p class="mt-3 max-w-[68ch] text-sm leading-relaxed" style="color: var(--pro-dim);">{p.abstract}</p>}
            </div>
            <p class="tag">
              {p.category} · {p.status}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="pt-16 sm:pt-24">
    <a href={`${b}pro/contact`} class="pro-cta">Collaborate <LucideIcon name="ArrowUpRight" size={26} /></a>
  </section>
</ProLayout>