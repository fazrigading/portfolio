---
import { getCollection } from 'astro:content';
import ProLayout from '../../layouts/ProLayout.astro';
import pro from '../../data/pro.json';

const b = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort((a, b2) => (a.data.date < b2.data.date ? 1 : -1));
---

<ProLayout title="Blog" kicker="Writing" section="Blog">
  <div class="grid gap-y-8 pt-8 sm:pt-12 lg:grid-cols-12 lg:gap-x-12">
    <p class="pro-body lg:col-span-7">
      Notes on systems, models and Linux desktops — the things worth writing down because they cost more than
      an afternoon to work out. The writing does not care which door you came through; the same posts are
      listed on the Personal side in that zone's own grammar.
    </p>
    <p class="pro-eyebrow lg:col-span-5 lg:pt-3 lg:text-right">
      {posts.length} {posts.length === 1 ? 'entry' : 'entries'}
    </p>
  </div>

  <div class="pt-12 sm:pt-16">
    {
      posts.length === 0 && (
        <p class="pro-body" style="color: var(--pro-dim);">
          Nothing published yet.
        </p>
      )
    }
    {
      posts.map((p) => (
        <article class="pro-post">
          <div class="grid gap-x-12 lg:grid-cols-12">
            <div class="lg:col-span-8">
              <h2 class="pro-post-title">
                <a href={`${b}pro/blog/${p.data.slug}`} class="pro-link">{p.data.title}</a>
              </h2>
              <p class="pro-work-body mt-4">{p.data.excerpt}</p>
            </div>
            <p class="pro-label lg:col-span-4 lg:pt-2 lg:text-right">{p.data.date}</p>
          </div>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
            <a href={`${b}pro/blog/${p.data.slug}`} class="pro-link text-sm">Read →</a>
            {p.data.tags.map((t) => (
              <span class="pro-tag">{t}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <section class="pt-16 sm:pt-24" aria-label="Reach out">
    <p class="pro-eyebrow">{pro.contact.headline}</p>
    <a href={pro.contact.primary.href} class="pro-cta mt-5">Contact me</a>
  </section>
</ProLayout>

<style>
  .pro-post {
    padding: 1.6rem 0;
    border-top: 1px solid var(--pro-rule);
  }
  .pro-post-title {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pro-post-title a { text-decoration: none; }
  .pro-work-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--pro-dim);
    max-width: 62ch;
  }
  .pro-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--pro-dim);
    border: 1px solid var(--pro-rule);
    padding: 0.15rem 0.45rem;
  }
</style>