---
import '../styles/global.css';
import '../styles/pro.css';
import pro from '../data/pro.json';
import dev from '../data/dev.json';
import profile from '../data/profile.json';
import social from '../data/social.json';
import learning from '../data/learning.json';
import { getCollection } from 'astro:content';
import devWallpaper from '../assets/wallpapers/desktop/blue.webp';

const b = import.meta.env.BASE_URL;
const reach = social.socialLinks.filter((s) => s.name !== 'E-mail');

const posts = (await getCollection('blog'))
  .sort((a, b2) => (a.data.date < b2.data.date ? 1 : -1))
  .slice(0, 3);

const experience = JSON.parse(JSON.stringify((await import('../data/experience.json')).default)) as {
  role: string;
  company: string;
  period: string;
  type: string;
}[];

/* Certifications split by what they attest to: a technical credential, a
   provider/organisation, or something else entirely (language, bootcamp).
   Tagged from the data rather than hand-listed, so a new credential lands in
   the right bucket on its own. */
const TECH = new Set(['AI', 'ML', 'DL', 'CV', 'DS', 'SWE', 'TF', 'Python', 'R', 'SQL', 'JS', 'PHP', 'Web', 'Git']);
const certs = learning.filter((l) => l.type === 'Certification');
const techCerts = certs.filter((c) => c.tags?.some((t) => TECH.has(t)));
const orgCerts = [...new Map(certs.filter((c) => !c.tags?.some((t) => TECH.has(t))).map((c) => [c.provider, c])).values()];
const otherCerts = learning.filter((l) => l.type !== 'Certification');

/* Experience splits the same way: shipped engineering work, institutional
   roles, and everything else — clubs, events, media, freelance. */
const isOrg = (e: (typeof experience)[number]) => /university|academy|it s\.?e|sekolah/i.test(e.company);
const techExp = experience.filter((e) => !isOrg(e));
const orgExp = experience.filter(isOrg);
const otherExp = experience.filter((e) => !isOrg(e) && /fest|core team|intern|club|podcast|cafe|staff|committee|guide|member|caster/i.test(e.role));

const metrics = [
  { value: '6', label: 'Scopus papers', note: 'two in Q1 journals' },
  { value: String(certs.length), label: 'Certifications', note: `${techCerts.length} technical · ${orgCerts.length} other` },
  { value: String(experience.length), label: 'Roles held', note: `${orgExp.length} institutional · ${techExp.length} technical` },
];

/* One rolling ledger of everything behind the Professional door, kept in
   three separate runs rather than one queue, so each voice stays legible
   instead of dissolving into a single crawl. */
const runs = [
  { key: 'exp', label: 'Experience', items: experience.map((e) => ({ k: e.period, v: `${e.role} · ${e.company}` })) },
  { key: 'crt', label: 'Certified', items: certs.map((c) => ({ k: c.date, v: `${c.title} · ${c.provider}` })) },
  { key: 'log', label: 'Blog', items: posts.map((p) => ({ k: p.data.date, v: p.data.title })) },
].filter((r) => r.items.length);
---

<!doctype html>
<html lang="en" data-zone="split" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.roles.join(', ')}. Two worlds: professional CV and research, and a personal terminal, game library and gallery.`}
    />
    <title>{profile.name} — Professional // Personal</title>
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    {/* The two faces the display and the labels need. Preloaded because the
        name is the h2 and a cold swap visibly reflows it. */}
    <link rel="preload" as="font" type="font/woff2" href={`${b}fonts/Archivo-var.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${b}fonts/IBMPlexMono-normal-400.woff2`} crossorigin />
    <style is:global>
      /* Metric-matched fallback faces. Archivo is the display voice, so its
         swap period must not resize the name: these overrides approximate the
         real advance width and vertical metrics of the fallback face. */
      @font-face {
        font-family: "Archivo Fallback";
        src: local("Helvetica Neue"), local("Arial"), local("Liberation Sans");
        size-adjust: 97%;
        ascent-override: 96%;
        descent-override: 24%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: "Plex Mono Fallback";
        src: local("DejaVu Sans Mono"), local("Liberation Mono"), local("Menlo");
        size-adjust: 94%;
        ascent-override: 92%;
        descent-override: 24%;
        line-gap-override: 0%;
      }
      @font-face{font-family:"VT323";src:url("/fonts/VT323-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-800.woff2") format("woff2");font-weight:800;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var.woff2") format("woff2");font-weight:400 700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var-italic.woff2") format("woff2");font-weight:400 600;font-display:swap}
      @font-face{font-family:"Archivo";src:url("/fonts/Archivo-var.woff2") format("woff2");font-weight:400 800;font-stretch:62% 125%;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-500.woff2") format("woff2");font-weight:500;font-display:swap}
    </style>
  </head>

  <body class="split-body antialiased">
    <h1 class="sr-only">Fazri Gading — two worlds: Professional and Personal</h1>

    <!-- ═══ two snapped viewports. One scroll moves between them. ═══ -->
    <div class="scroll-track" id="scroll-track">
      <span class="sr-only">Scroll down to move between the two worlds.</span>

      <!-- ══════ VIEW ONE — PROFESSIONAL dominant ══════ -->
      <section class="view view-one" aria-label="Professional">
        <!-- The panel is scenery, not a door: only the CTA below navigates. -->
        <div class="panel panel-pro">
          <div class="panel-inner">
            <!-- ── identity: who he is ── -->
            <div class="identity">
              <div class="identity-main">
                <p class="name-lead">My name is</p>
                <h2 class="split-name">Fazri<br />Gading</h2>
              </div>
              <div class="identity-side">
                <p class="split-standfirst">
                  {profile.about.intro.split('. ').slice(0, 2).join('. ')}.
                </p>
                <nav class="reach-row" aria-label="Professional contact links">
                  <a href={pro.contact.primary.href} class="reach-link" data-primary>E-Mail</a>
                  {reach.map((s) => (
                    <a href={s.href} target="_blank" rel="noreferrer" class="reach-link">{s.name}</a>
                  ))}
                </nav>
              </div>
            </div>

            <!-- ── proof ── -->
            <div class="split-measure">
              {metrics.map((m) => (
                <span class="metric"><b>{m.value}</b><span>{m.label}<i>{m.note}</i></span></span>
              ))}
            </div>

            <!-- ── ledger: three voices, three rules ── -->
            <div class="ticker">
              {runs.map((r) => (
                <div class="lane" data-lane={r.key}>
                  <span class="lane-label">{r.label}</span>
                  <div class="lane-track">
                    <ul class="ticker-set">
                      {r.items.map((t) => (
                        <li class="ticker-item"><b>{t.k}</b>{t.v}</li>
                      ))}
                    </ul>
                    <ul class="ticker-set" aria-hidden="true">
                      {r.items.map((t) => (
                        <li class="ticker-item"><b>{t.k}</b>{t.v}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>

            <!-- ── the one door ── -->
            <a href={`${b}pro`} class="view-cta" data-jump="pro">
              <span class="view-cta-label">Check out my <span class="gold">Professional</span> Portfolio</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <!-- the collapsed slice: an invitation, not a door -->
        <div class="strip strip-dev">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name phos">Personal</span>
            <span class="strip-path">/dev</span>
          </span>
          <span class="strip-hint"><span>Scroll Down to see my Personal portfolio</span></span>
        </div>
        <div class="strip-hit" aria-hidden="true"></div>
      </section>

      <!-- ══════ VIEW TWO — PERSONAL dominant ══════ -->
      <section class="view view-two" aria-label="Personal">
        <div class="strip-hit" aria-hidden="true"></div>
        <div class="strip strip-pro">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name gold">Professional</span>
            <span class="strip-path">/pro</span>
          </span>
          <span class="strip-hint"><span>Scroll Up to see my Professional portfolio</span></span>
        </div>

        <div class="panel panel-dev">
          <span class="dev-wall"></span>
          <div class="panel-inner">
            <!-- fastfetch: mark on the left, machine readout on the right -->
            <div class="fastfetch">
              <pre class="ff-logo" aria-hidden="true">{dev.banner.join('\n')}</pre>
              <dl class="ff-rows">
                {dev.status.map((s) => (
                  <span class="ff-row"><dt>{s.k}</dt><dd>{s.v}</dd></span>
                ))}
              </dl>
            </div>

            <nav class="ff-hubs" aria-label="Personal sections">
              {dev.hubs.map((h) => (
                <a href={`${b}${h.href}`} class="ff-hub">{h.title}</a>
              ))}
            </nav>

            <a href={`${b}dev`} class="view-cta" data-jump="dev">
              <span class="view-cta-label">Check out my <span class="phos">Personal</span> Portfolio</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </body>
</html>

<style>
  /* ── spacing scale ──
     A 4-unit base: the 8/12 steps carry tight intra-group rhythm and the
     24/32/44 steps carry the major band breaks. Rhythm comes from the
     contrast between those two families, never from one value repeated. */
  .split-body {
    --s1: 4px;
    --s2: 8px;
    --s3: 12px;
    --s4: 16px;
    --s5: 24px;
    --s6: 32px;
    --s7: 44px;

    /* ── type roles ──
       Named by job, not by value, so a role can be re-tuned in one place.
       Two families, no third: Archivo carries voice and prose, IBM Plex Mono
       carries labels and data. The dense band is 11/12/13/14 — a 1px step
       alone would be invisible, so each role also separates by weight, case,
       tracking or colour. */
    --t-display: clamp(2.4rem, 5.4vw, 4.6rem); /* the name */
    --t-deck: clamp(1rem, 1.15vw, 1.125rem); /* standfirst prose */
    --t-value: 0.875rem; /* fact value */
    --t-readout: 0.8125rem; /* fastfetch value */
    --t-label: 0.6875rem; /* any key or qualifier */
    --t-body: 0.75rem; /* any running value */
    --t-data: clamp(1.5rem, 2.6vw, 2.2rem); /* the three proof numerals */
    --t-mark: clamp(0.42rem, 0.55vw, 0.62rem); /* ASCII wordmark */

    margin: 0;
    background-color: #0b0d10;
    background-image: none;
    color: #f2ede4;
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
  }

  /* ── the track: a viewport-tall scroller over two 100svh views ──
     Height must be ONE viewport, never the sum of its children: sizing the
     track to the total content height leaves nothing to scroll. `dvh` is
     deliberate — the track follows a mobile URL bar while the views stay on
     `svh`, so a shrinking bar cannot crop their content. */
  .scroll-track {
    height: 100dvh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: thin;
    scrollbar-color: #2a303b #0b0d10;
  }
  .scroll-track::-webkit-scrollbar { width: 10px; }
  .scroll-track::-webkit-scrollbar-track { background: #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb { background: #2a303b; border: 3px solid #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb:hover { background: #3c434f; }

  .view {
    position: relative;
    display: grid;
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 0;
/* The hover trigger is `.strip-hit`, NOT the slice itself. The slice is a
       grid track, so growing it moves its own edge — a pointer resting on
       that edge oscillated forever: the expansion pushed it out (collapse),
       the collapse pulled it back in (expand). `.strip-hit` is an invisible
       band pinned to the view's edge, so the hover boundary stays put while
       the slice moves underneath it. */
    --hit: 9vh;
    transition: grid-template-rows 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* view one: 80 / 20 — view two: 20 / 80. The slice track is `auto` at
     rest, so it holds the ~20% it was given instead of being clipped. */
  .view-one { grid-template-rows: 1fr auto; }
  .view-two { grid-template-rows: auto 1fr; }
  .view-one:has(.strip-hit:hover) { grid-template-rows: 1fr 15%; }
  .view-two:has(.strip-hit:hover) { grid-template-rows: 15% 1fr; }

  /* quiet entrance: everything rises into place, nothing sweeps across */
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .panel, .strip, .view-cta { animation: rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .view-two > * { animation-delay: 0.06s; }

  /* ── panels: scenery, not links ── */
  .panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    color: inherit;
  }
  .panel-pro { background: #0b0d10; }
  .panel-dev { background: #07080b; }

  /* Both views share one measure: full width inside the panel padding, so
     the ruled Pro blocks and the Personal card sit on the same inline box. */
  .panel-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0;
    height: 100%;
    padding: var(--s5) clamp(1rem, 4vw, 2.5rem);
  }

  /* ── band 1: identity ── */
  .identity {
    display: grid;
    /* tracks follow the content, not the type */
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    align-items: end;
    width: 100%;
  }
  .identity-main { min-width: 0; }
  .identity-side { min-width: 0; }

  .name-lead {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: clamp(0.9375rem, 1.35vw, 1.1875rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c8a96a;
  }

  .split-name {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 800;
    /* `font-variation-settings` overrides `font-stretch` on the same axis, so
       the width axis is set in exactly one place. Declaring both left
       `font-stretch` silently dead and the tracking tuned for a cut the type
       never rendered at. */
    font-stretch: 78%;
    font-size: var(--t-display);
    line-height: 0.94;
    letter-spacing: -0.045em;
    margin-top: var(--s1);
  }
  .split-standfirst {
    font-size: var(--t-deck);
    line-height: 1.5;
    /* light grey on a near-black ground needs a touch of tracking to hold
       its word shapes; the measure must clear 45ch */
    letter-spacing: 0.005em;
    color: #b9bfc9;
    max-width: 58ch;
  }

  /* contact doors sit with the prose they support */
  .reach-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s4);
    margin-top: var(--s3);
  }
  .reach-link {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #a3abba;
    transition: color 0.2s ease;
  }
  .reach-link:hover { color: #c8a96a; }
  /* the primary door is the one action; the rest are quiet */
  .reach-link[data-primary] {
    color: #f2ede4;
    border-bottom: 1px solid #c8a96a;
    padding-bottom: 2px;
  }
  .reach-link[data-primary]:hover { color: #c8a96a; }

  /* ── band 2: proof — the major break, then the ledger ── */
  .split-measure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin-top: var(--s7);
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
  }
  .metric { display: flex; gap: var(--s3); align-items: baseline; padding: var(--s2) var(--s4) var(--s2) 0; }
  .metric + .metric { border-left: 1px solid #262b34; padding-left: var(--s4); }
  .metric b {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 800;
    /* one axis, one declaration — see `.split-name` */
    font-stretch: 85%;
    font-size: var(--t-data);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .metric > span { font-size: var(--t-body); line-height: 1.3; color: #b9bfc9; }
  .metric i {
    display: block;
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-style: normal;
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8a96a;
    margin-top: var(--s1);
  }

  /* ── band 3: the rolling ledger ──
     Three voices, three rules. A single queue of every role, credential and
     post dissolves into an unreadable crawl; giving each its own lane lets
     the eye tell what kind of thing it is reading before it reads it. */
  .ticker {
    width: 100%;
    margin-top: var(--s5);
    border-top: 1px solid #262b34;
    overflow: hidden;
  }
  .lane {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    border-bottom: 1px solid #262b34;
  }
  .lane-label {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6d7482;
    padding: var(--s2) var(--s3) var(--s2) 0;
    border-right: 1px solid #262b34;
    white-space: nowrap;
  }
  .lane-track {
    display: flex;
    width: max-content;
    overflow: hidden;
    padding: var(--s2) 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    animation: ticker-scroll var(--lane-speed, 64s) linear infinite;
  }
  .ticker:hover .lane-track { animation-play-state: paused; }
  .ticker-set { display: flex; align-items: baseline; margin: 0; padding: 0; list-style: none; }
  .ticker-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s2);
    padding: 0 var(--s4);
    white-space: nowrap;
    font-size: var(--t-body);
    line-height: 1.6;
  }
  .ticker-item::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-left: var(--s4);
    border-radius: 50%;
    background: #3a414d;
    transform: translateY(-3px);
  }
  .ticker-item b { font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; }

  /* EXPERIENCE — terminal mono, cold. Roles read as command-line output. */
  .lane[data-lane='exp'] .lane-label { color: #9aa2b0; }
  .lane[data-lane='exp'] .ticker-item { font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace; color: #b6bdc9; }
  .lane[data-lane='exp'] .ticker-item b { color: #8d94a2; font-size: var(--t-label); letter-spacing: 0.1em; }
  .lane[data-lane='exp'] .lane-track { --lane-speed: 78s; }

  /* CERTIFIED — the gold one. Each credential stamped in the accent. */
  .lane[data-lane='crt'] .lane-label { color: #c8a96a; }
  .lane[data-lane='crt'] .ticker-item { font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace; color: #cfd4dc; }
  .lane[data-lane='crt'] .ticker-item b { color: #c8a96a; font-size: var(--t-label); letter-spacing: 0.12em; }
  .lane[data-lane='crt'] .lane-track { --lane-speed: 92s; }

  /* BLOG — the only proportional voice here, set apart as prose rather than
     data. Weight 500 reads it as a title, not a log line. */
  .lane[data-lane='log'] .lane-label { color: #7f8798; }
  .lane[data-lane='log'] .ticker-item {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: #b9bfc9;
  }
  .lane[data-lane='log'] .ticker-item b { color: #8d94a2; font-size: var(--t-label); font-weight: 400; }
  .lane[data-lane='log'] .lane-track { --lane-speed: 56s; }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── the door: last child of the panel, so it lands in the same place in
        both views instead of overlaying the strip in one and the panel in
        the other ── */
  .view-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
    margin-top: var(--s6);
    padding: var(--s3) var(--s5);
    text-decoration: none;
    color: #f2ede4;
    border: 1px solid #3a414d;
    transition: color 0.22s ease, border-color 0.22s ease, gap 0.22s ease;
  }
  .view-cta-label {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
