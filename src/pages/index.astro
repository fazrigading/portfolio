---
import '../styles/global.css';
import '../styles/pro.css';
import pro from '../data/pro.json';
import dev from '../data/dev.json';
import profile from '../data/profile.json';
import social from '../data/social.json';
import showcase from '../data/showcase.json';
import devWallpaper from '../assets/wallpapers/desktop/blue.webp';

const b = import.meta.env.BASE_URL;
const research = (await import('../data/research.json')).default;
const q1 = research.filter((r) => r.category === 'Scopus Q1');
const reach = social.socialLinks.filter((s) => s.name !== 'E-mail');
const covers = [...showcase.gaming.nowPlaying, ...showcase.gaming.likedGames].slice(0, 6);
---

<!doctype html>
<html lang="en" data-zone="split" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.roles.join(', ')}. Two worlds: professional CV and research, and a personal terminal, game library and gallery.`}
    />
    <title>{profile.name} — Professional // Personal</title>
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        try {
          var z = localStorage.getItem('dedsec-zone');
          if (z) document.documentElement.dataset.lastZone = z;
        } catch {}
      })();
    </script>
    <style is:global>
      @font-face{font-family:"VT323";src:url("/fonts/VT323-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-800.woff2") format("woff2");font-weight:800;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var.woff2") format("woff2");font-weight:400 700;font-display:swap}
      @font-face{font-family:"Archivo";src:url("/fonts/Archivo-var.woff2") format("woff2");font-weight:400 800;font-stretch:62% 125%;font-display:swap}
    </style>
  </head>

  <body class="split-body antialiased">
    <!-- ═══ boot sweep: one scanline crosses the page, then the split settles ═══ -->
    <div class="boot-sweep" aria-hidden="true"></div>

    <!-- ═══ the shared baseline: one rule both worlds obey ═══ -->
    <div class="zone-rail" id="zone-rail">
      <p class="split-eyebrow">{profile.name}<span class="gold"> — two worlds, one baseline</span></p>
      <div class="rail-links" role="group" aria-label="Choose a zone">
        <a href={`${b}pro`} data-jump="pro" class="rail-link">Professional<span class="rail-kicker">/pro</span></a>
        <a href={`${b}dev`} data-jump="dev" class="rail-link phos">Personal<span class="rail-kicker">/dev</span></a>
      </div>
    </div>

    <main class="split" id="split">
      <!-- ══════════ TOP — PROFESSIONAL ══════════ -->
      <a href={`${b}pro`} class="panel panel-pro" data-panel="pro" aria-label="Enter the Professional zone: CV, experience, research, contact">
        <span class="panel-inner">
          <span class="panel-grid">
            <span class="panel-col-left">
              <span class="split-eyebrow gold block">{pro.kicker}</span>
              <span class="pro-display split-name block">Fazri<br />Gading</span>
              <span class="split-standfirst block">
                {profile.about.intro.split('. ').slice(0, 2).join('. ')}.
              </span>
            </span>
            <span class="panel-col-right">
              <span class="split-eyebrow block">Currently</span>
              <span class="spec-list block">
                <span class="spec-row"><span class="k">Role</span><span class="v">{profile.roles[0]} · {profile.roles[1]}</span></span>
                <span class="spec-row"><span class="k">Org</span><span class="v">Mulawarman University</span></span>
                <span class="spec-row"><span class="k">Since</span><span class="v">2023</span></span>
                <span class="spec-row"><span class="k">Focus</span><span class="v">CV · LLM apps · RAG</span></span>
              </span>
            </span>
          </span>

          <span class="split-measure block">
            <span class="metric"><b>6</b><span>Scopus papers<i>2 in Q1</i></span></span>
            <span class="metric"><b>225+</b><span>Students taught<i>ML &amp; lab work</i></span></span>
            <span class="metric"><b>10</b><span>Shipped projects<i>Python · TS · Unity</i></span></span>
          </span>

          <span class="split-reach block">
            <span class="split-cta">
              {pro.contact.primary.value}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </span>
            <span class="reach-rest">
              {reach.map((s) => (
                <span class="reach-link">
                  {s.name}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                </span>
              ))}
            </span>
          </span>
        </span>
        <span class="panel-corner">
          <span class="split-eyebrow">Enter Professional</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <!-- ═══ THE BASELINE — the seam. Both halves obey it; only it may move. ═══ -->
      <div class="baseline" aria-hidden="true">
        <span class="baseline-tick"></span>
        <span class="baseline-word">THE BASELINE</span>
        <span class="baseline-tick"></span>
      </div>

      <!-- ══════════ BOTTOM — PERSONAL ══════════ -->
      <a href={`${b}dev`} class="panel panel-dev" data-panel="dev" aria-label="Enter the Personal zone: terminal, game library, gallery">
        <span class="panel-inner">
          <span class="dev-wall" aria-hidden="true"></span>
          <span class="dev-scan" aria-hidden="true"></span>
          <span class="panel-grid">
            <span class="panel-col-left">
              <span class="dev-prompt block"><span class="caret"></span></span>
              <span class="dev-log block">
                {dev.boot.map((l) => (
                  <span class="dev-log-line">{l}</span>
                ))}
              </span>
              <span class="split-eyebrow phos block">type <b>help</b> · press enter</span>
            </span>
            <span class="panel-col-right">
              <pre class="dev-banner" aria-hidden="true">{dev.banner.join('\n')}</pre>
              <span class="cover-strip block">
                {covers.map((g) => (
                  <img src={`${b}game-covers/${g.cover}`} alt="" loading="lazy" class="cover-thumb" />
                ))}
              </span>
            </span>
          </span>
          <span class="split-reach block dev-reach">
            <span class="split-cta phos">
              Enter the terminal
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
            <span class="reach-rest phos">
              {dev.hubs.map((h) => (
                <span class="reach-link">{h.title}</span>
              ))}
            </span>
          </span>
        </span>
        <span class="panel-corner">
          <span class="split-eyebrow phos">Enter Personal</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </main>
  </body>
</html>

<style>
  .split-body {
    margin: 0;
    min-height: 100svh;
    /* Pro half owns the upper ground; the Dev half paints its own below. */
    background-color: #0b0d10;
    background-image: none;
    color: #f2ede4;
    font-family: 'Archivo', system-ui, sans-serif;
    overflow: hidden;
  }

  /* ── boot: one scanline crosses the page, 1.1s, then the split is readable ── */
  .boot-sweep {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(200, 169, 106, 0.16) 46%,
      rgba(200, 169, 106, 0.55) 50%,
      rgba(93, 255, 155, 0.16) 54%,
      transparent 100%
    );
    height: 22vh;
    top: -22vh;
    animation: sweep 1.1s cubic-bezier(0.5, 0, 0.2, 1) both;
  }
  @keyframes sweep {
    0% { top: -22vh; opacity: 1; }
    70% { opacity: 1; }
    100% { top: 100vh; opacity: 0; }
  }
  /* panels rise into place behind the sweep */
  .panel-inner,
  .baseline { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: 0.25s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* ── zone rail: one line, above everything, its own tiny grammar ── */
  .zone-rail {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem clamp(1rem, 4vw, 2.5rem);
    mix-blend-mode: normal;
  }
  .rail-links { display: flex; gap: 1.25rem; }
  .rail-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d94a2;
    text-decoration: none;
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .rail-link.phos:hover { color: #5dff9b; border-color: #5dff9b; }
  .rail-link:hover { color: #c8a96a; border-color: #c8a96a; }
  .rail-kicker { font-size: 0.625rem; opacity: 0.55; }

  /* ── the split: two rows, one track each; hover rebalances the tracks ── */
  /* Three rows: Pro panel, the seam, Dev panel. The seam is min-content so it
     never steals from the panels — that is what keeps the rest 50/50 exactly.
     `fr` tracks share all free space; both panels are min-height:0 so their
     content never inflates a track. */
  .split {
    display: grid;
    grid-template-rows: 1fr min-content 1fr;
    height: 100svh;
    padding-top: 2.6rem;
    transition: grid-template-rows 0.62s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .split:has(.panel-pro:hover),
  .split:has(.panel-dev:focus-visible) { grid-template-rows: 1.72fr min-content 0.68fr; }
  .split:has(.panel-dev:hover),
  .split:has(.panel-pro:focus-visible) { grid-template-rows: 0.68fr min-content 1.72fr; }

  .panel {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    outline: none;
  }
  .panel-pro { background: #0b0d10; color: #f2ede4; }
  .panel-dev { background: #07080b; color: #f2ede4; }

  .panel-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1rem, 2.4vh, 1.9rem);
    /* collapsed panels anchor to the seam so the two halves read as one
       continuous document instead of two floating blocks */
    justify-content: flex-end;
    height: 100%;
    padding: clamp(1rem, 2.6vh, 1.6rem) clamp(1rem, 4vw, 2.5rem) clamp(2.4rem, 5vh, 3.2rem);
    transition: opacity 0.4s ease;
  }
  /* The receding half dims and drops its secondary blocks rather than being
     clipped mid-word at the seam: the baseline carries the eye, not a cut line. */
  .split:has(.panel-pro:hover) .panel-dev .panel-inner,
  .split:has(.panel-dev:hover) .panel-pro .panel-inner { opacity: 0.4; }
  .split:has(.panel-pro:hover) .panel-dev .split-measure,
  .split:has(.panel-dev:hover) .panel-pro .split-measure,
  .split:has(.panel-pro:hover) .panel-dev .panel-col-right,
  .split:has(.panel-dev:hover) .panel-pro .panel-col-right {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .split-measure, .panel-col-right { transition: opacity 0.45s ease 0.12s, transform 0.45s ease 0.12s; }
  .panel:hover .panel-inner,
  .panel:focus-visible .panel-inner { opacity: 1 !important; justify-content: center; }

  .panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .panel-col-left { min-width: 0; }
  .panel-col-right { min-width: 0; }
  .block { display: block; }

  /* ── type ladder ── */
  .split-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8d94a2;
    font-style: normal;
  }
  .split-eyebrow.gold, .gold { color: #c8a96a; }
  .split-eyebrow.phos, .phos { color: #5dff9b; }
  .split-eyebrow b { color: inherit; font-weight: 700; }

  .split-name {
    display: block;
    margin-top: 0.5rem;
    font-family: 'Bodoni Moda', Didot, Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 6.4vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .split-standfirst {
    margin-top: 0.85rem;
    font-size: clamp(0.9rem, 1.15vw, 1.05rem);
    line-height: 1.55;
    color: #b9bfc9;
    max-width: 46ch;
  }

  /* spec-sheet rows, ruled — the Pro half's own grammar */
  .spec-list { display: block; margin-top: 0.6rem; }
  .spec-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.42rem 0;
    border-top: 1px solid #262b34;
  }
  .spec-row .k {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6d7482;
    padding-top: 0.2em;
  }
  .spec-row .v { font-size: 0.8rem; line-height: 1.35; color: #cfd4dc; }

  /* the metrics measure: three columns on one rule, shared by both halves' rhythm */
  .split-measure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
  }
  .metric { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.55rem 1.25rem 0.5rem 0; }
  .metric + .metric { border-left: 1px solid #262b34; padding-left: 1.25rem; }
  .metric b {
    font-family: 'Bodoni Moda', Didot, Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.7vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .metric > span { font-size: 0.72rem; line-height: 1.3; color: #b9bfc9; }
  .metric i {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-style: normal;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8a96a;
    margin-top: 0.2rem;
  }

  /* reach row: the primary action sits on the same baseline as everything */
  .split-reach { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .split-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.005em;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid #c8a96a;
    transition: gap 0.22s ease, color 0.22s ease;
  }
  .split-cta.phos { border-color: #5dff9b; }
  .panel-pro:hover .split-cta { gap: 1.05rem; color: #c8a96a; }
  .panel-dev:hover .split-cta { gap: 1.05rem; color: #5dff9b; }
  .reach-rest { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .reach-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8d94a2;
  }
  .reach-link svg { opacity: 0; transition: opacity 0.2s ease, transform 0.2s ease; transform: translate(-3px, 3px); }
  .panel:hover .reach-link svg { opacity: 0.7; transform: none; }

  /* ── the seam ── */
  .baseline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }
  .baseline-tick { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #3a414d 20%, #3a414d 80%, transparent); }
  .baseline-word {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #565e6c;
    white-space: nowrap;
  }

  /* ── Personal half texture: wallpaper bleed + scanlines ── */
  .dev-wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('{devWallpaper.src}');
    background-size: cover;
    background-position: center;
    opacity: 0.16;
    filter: saturate(0.7);
  }
  .dev-scan {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0 1px, transparent 1px 3px);
    opacity: 0.5;
  }

  .dev-prompt {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
    color: #5dff9b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    background: #5dff9b;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .dev-log { margin-top: 0.85rem; display: block; }
  .dev-log-line {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.62rem, 0.82vw, 0.75rem);
    line-height: 1.75;
    color: #7f8798;
    letter-spacing: 0.02em;
  }
  .dev-log-line:first-child { color: #a7afbd; }

  .dev-banner {
    font-family: 'VT323', monospace;
    /* 63 glyphs must fit the right column: size off the column, not the viewport */
    font-size: clamp(0.3rem, 0.52vw, 0.6rem);
    line-height: 1.02;
    color: #5dff9b;
    margin: 0;
    opacity: 0.82;
    white-space: pre;
    transform-origin: left top;
    transform: scale(1);
    width: 100%;
  }
  @media (max-width: 900px) { .dev-banner { font-size: 0.62rem; } }

  .cover-strip { display: flex; gap: 0.4rem; margin-top: 1rem; }
  .cover-thumb {
    width: clamp(28px, 4.2vw, 44px);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid #2b313b;
    filter: saturate(0.75) contrast(1.05);
    transition: filter 0.3s ease, transform 0.3s ease;
  }
  .panel-dev:hover .cover-thumb { filter: none; transform: translateY(-2px); }

  .dev-reach .split-cta { color: #e8f7ee; }

  /* corner affordance, appears on hover */
  .panel-corner {
    position: absolute;
    z-index: 3;
    bottom: clamp(0.75rem, 2vh, 1.15rem);
    right: clamp(1rem, 4vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.28s ease, transform 0.28s ease;
  }
  .panel:hover .panel-corner,
  .panel:focus-visible .panel-corner { opacity: 1; transform: none; }
  .panel:focus-visible { box-shadow: inset 0 0 0 2px #c8a96a; }
  .panel-dev:focus-visible { box-shadow: inset 0 0 0 2px #5dff9b; }

  /* ── narrow: stack, hover can no longer expand, so tap does ── */
  @media (max-width: 780px) {
    .split { grid-template-rows: 1fr min-content 1fr; height: auto; min-height: 100svh; padding-top: 3rem; transition: none; }
    .split-body { overflow: auto; }
    .panel-grid { grid-template-columns: 1fr; gap: 1.1rem; }
    .panel-corner { display: none; }
    .split-measure { grid-template-columns: 1fr; }
    .metric { padding: 0.4rem 0; }
    .metric + .metric { border-left: 0; border-top: 1px solid #262b34; padding-left: 0; }
    .reach-rest { display: none; }
    /* the tagline wraps into a tall column at 390px and starves the split —
       drop it, the rail's job on mobile is the two zone links only */
    .zone-rail > p { display: none; }
    .zone-rail { position: sticky; justify-content: flex-end; background: rgba(11, 13, 16, 0.92); backdrop-filter: blur(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-sweep { display: none; }
    .panel-inner, .baseline { animation: none; }
    .caret { animation: none; }
    .split { transition: none; }
    .split-cta, .cover-thumb, .panel-corner { transition: none; }
  }
</style>

<script>
  // One behaviour: the shared baseline rebalances the two tracks on hover/focus.
  // Touch has no hover — tap focuses the panel, which triggers the same tracks.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-jump]').forEach((a) => {
      if (a.dataset.bound) return;
      a.dataset.bound = '1';
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('dedsec-zone', a.dataset.jump === 'pro' ? 'pro' : 'dev');
        } catch {}
      });
    });
  });
</script>