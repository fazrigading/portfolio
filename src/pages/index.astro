---
import '../styles/global.css';
import '../styles/pro.css';
import pro from '../data/pro.json';
import dev from '../data/dev.json';
import profile from '../data/profile.json';
import social from '../data/social.json';
import learning from '../data/learning.json';
import { getCollection } from 'astro:content';
import devWallpaper from '../assets/wallpapers/desktop/blue-alt.webp';

const b = import.meta.env.BASE_URL;
const reach = social.socialLinks.filter((s) => s.name !== 'E-mail');

const posts = (await getCollection('blog'))
  .sort((a, b2) => (a.data.date < b2.data.date ? 1 : -1))
  .slice(0, 3);
const certs = learning.filter((l) => l.type === 'Certification').slice(0, 6);

/* One rolling ledger of everything behind the Professional door: roles,
   certifications and the latest posts. Rendered twice so the -50% translate
   loops without a seam — the second copy is hidden from assistive tech, which
   reads the first. */
const ticker = [
  ...pro.roles.map((r) => ({ k: 'Experience', v: `${r.role} · ${r.org}` })),
  ...certs.map((c) => ({ k: 'Certified', v: `${c.title} · ${c.provider}` })),
  ...posts.map((p) => ({ k: 'Blog', v: p.data.title })),
];
const facts = [
  { k: 'Role', v: `${profile.roles[0]} · ${profile.roles[1]}` },
  { k: 'Org', v: 'Mulawarman University' },
  { k: 'Since', v: '2023' },
  { k: 'Focus', v: 'CV · LLM apps · RAG' },
];
---

<!doctype html>
<html lang="en" data-zone="split" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.roles.join(', ')}. Two worlds: professional CV and research, and a personal terminal, game library and gallery.`}
    />
    <title>{profile.name} — Professional // Personal</title>
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    {/* The two faces the display and the labels need. Preloaded because the
        name is the h2 and a cold swap visibly reflows it. */}
    <link rel="preload" as="font" type="font/woff2" href={`${b}fonts/Archivo-var.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${b}fonts/IBMPlexMono-normal-400.woff2`} crossorigin />
    <style is:global>
      /* Metric-matched fallback faces. Archivo is the display voice, so its
         swap period must not resize the name: these overrides approximate the
         real advance width and vertical metrics of the fallback face. */
      @font-face {
        font-family: "Archivo Fallback";
        src: local("Helvetica Neue"), local("Arial"), local("Liberation Sans");
        size-adjust: 97%;
        ascent-override: 96%;
        descent-override: 24%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: "Plex Mono Fallback";
        src: local("DejaVu Sans Mono"), local("Liberation Mono"), local("Menlo");
        size-adjust: 94%;
        ascent-override: 92%;
        descent-override: 24%;
        line-gap-override: 0%;
      }
      @font-face{font-family:"VT323";src:url("/portfolio/fonts/VT323-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Syne";src:url("/portfolio/fonts/Syne-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Syne";src:url("/portfolio/fonts/Syne-normal-800.woff2") format("woff2");font-weight:800;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/portfolio/fonts/JetBrainsMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/portfolio/fonts/JetBrainsMono-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/portfolio/fonts/BodoniModa-var.woff2") format("woff2");font-weight:400 700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/portfolio/fonts/BodoniModa-var-italic.woff2") format("woff2");font-weight:400 600;font-display:swap}
      @font-face{font-family:"Archivo";src:url("/portfolio/fonts/Archivo-var.woff2") format("woff2");font-weight:400 800;font-stretch:62% 125%;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/portfolio/fonts/IBMPlexMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/portfolio/fonts/IBMPlexMono-normal-500.woff2") format("woff2");font-weight:500;font-display:swap}
    </style>
  </head>

  <body class="split-body antialiased">
    <h1 class="sr-only">Fazri Gading — two worlds: Professional and Personal</h1>

    <!-- ═══ two snapped viewports. One scroll moves between them. ═══ -->
    <div class="scroll-track" id="scroll-track">
      <span class="sr-only">Scroll down to move between the two worlds.</span>

      <!-- ══════ VIEW ONE — PROFESSIONAL dominant ══════ -->
      <section class="view view-one" aria-label="Professional">
        <!-- The panel is scenery, not a door: only the CTA below navigates. -->
        <div class="panel panel-pro">
          <div class="panel-inner">
            <!-- ── identity: who he is, and how to reach him ── -->
            <div class="identity">
              <div class="identity-main">
                <h2 class="split-name">Fazri Gading</h2>
                <p class="split-standfirst">
                  {profile.about.intro.split('. ').slice(0, 2).join('. ')}.
                </p>
                <nav class="reach-row" aria-label="Professional contact links">
                  <a href={pro.contact.primary.href} class="reach-link">{pro.contact.primary.value}</a>
                  {reach.map((s) => (
                    <a href={s.href} target="_blank" rel="noreferrer" class="reach-link">{s.name}</a>
                  ))}
                </nav>
              </div>
              <dl class="facts">
                {facts.map((f) => (
                  <div class="fact">
                    <dt>{f.k}</dt>
                    <dd>{f.v}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <!-- ── proof: the three numbers, on one rule ── -->
            <div class="split-measure">
              <span class="metric"><b>6</b><span>Scopus papers<i>2 in Q1</i></span></span>
              <span class="metric"><b>225+</b><span>Students taught<i>ML &amp; lab work</i></span></span>
              <span class="metric"><b>10</b><span>Shipped projects<i>Python · TS · Unity</i></span></span>
            </div>

            <!-- ── ledger: experience, certifications, writing ── -->
            <div class="ticker">
              <div class="ticker-run">
                <ul class="ticker-set">
                  {ticker.map((t) => (
                    <li class="ticker-item"><b class="gold">{t.k}</b>{t.v}</li>
                  ))}
                </ul>
                <ul class="ticker-set" aria-hidden="true">
                  {ticker.map((t) => (
                    <li class="ticker-item"><b class="gold">{t.k}</b>{t.v}</li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- ── the one door ── -->
            <a href={`${b}pro`} class="view-cta" data-jump="pro">
              <span class="view-cta-label">Check out my <span class="gold">Professional</span> Portfolio</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <!-- the collapsed slice: an invitation, not a door -->
        <div class="strip strip-dev">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name phos">Personal</span>
            <span class="strip-path">/dev</span>
          </span>
          <span class="strip-hint"><span>Scroll Down to see my Personal portfolio</span></span>
        </div>
      </section>

      <!-- ══════ VIEW TWO — PERSONAL dominant ══════ -->
      <section class="view view-two" aria-label="Personal">
        <div class="strip strip-pro">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name gold">Professional</span>
            <span class="strip-path">/pro</span>
          </span>
          <span class="strip-hint"><span>Scroll Up to see my Professional portfolio</span></span>
        </div>

        <div class="panel panel-dev">
          <span class="dev-wall" style={`background-image: url(${devWallpaper.src})`}></span>
          <div class="panel-inner">
            <!-- fastfetch: mark on the left, machine readout on the right -->
            <div class="fastfetch">
              <pre class="ff-logo" aria-hidden="true">{dev.banner.join('\n')}</pre>
              <dl class="ff-rows">
                {dev.status.map((s) => (
                  <span class="ff-row"><dt>{s.k}</dt><dd>{s.v}</dd></span>
                ))}
              </dl>
            </div>

            <nav class="ff-hubs" aria-label="Personal sections">
              {dev.hubs.map((h) => (
                <a href={`${b}${h.href}`} class="ff-hub">{h.title}</a>
              ))}
            </nav>

            <a href={`${b}dev`} class="view-cta" data-jump="dev">
              <span class="view-cta-label">Check out my <span class="phos">Personal</span> Portfolio</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </body>
</html>

<style>
  /* ── spacing scale ──
     A 4-unit base: the 8/12 steps carry tight intra-group rhythm and the
     24/32/44 steps carry the major band breaks. Rhythm comes from the
     contrast between those two families, never from one value repeated. */
  .split-body {
    --s1: 4px;
    --s2: 8px;
    --s3: 12px;
    --s4: 16px;
    --s5: 24px;
    --s6: 32px;
    --s7: 44px;

    /* ── type roles ──
       Named by job, not by value, so a role can be re-tuned in one place.
       Two families, no third: Archivo carries voice and prose, IBM Plex Mono
       carries labels and data. The dense band is 11/12/13/14 — a 1px step
       alone would be invisible, so each role also separates by weight, case,
       tracking or colour. */
    --t-display: clamp(2.4rem, 5.4vw, 4.6rem); /* the name */
    --t-deck: clamp(1rem, 1.15vw, 1.125rem); /* standfirst prose */
    --t-value: 0.875rem; /* fact value */
    --t-readout: 0.8125rem; /* fastfetch value */
    --t-label: 0.6875rem; /* any key or qualifier */
    --t-body: 0.75rem; /* any running value */
    --t-data: clamp(1.5rem, 2.6vw, 2.2rem); /* the three proof numerals */
    --t-mark: clamp(0.42rem, 0.55vw, 0.62rem); /* ASCII wordmark */

    margin: 0;
    background-color: #0b0d10;
    background-image: none;
    color: #f2ede4;
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
  }

  /* ── the track: a viewport-tall scroller over two 100svh views ──
     Height must be ONE viewport, never the sum of its children: sizing the
     track to the total content height leaves nothing to scroll. `dvh` is
     deliberate — the track follows a mobile URL bar while the views stay on
     `svh`, so a shrinking bar cannot crop their content. */
  .scroll-track {
    height: 100dvh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: thin;
    scrollbar-color: #2a303b #0b0d10;
  }
  .scroll-track::-webkit-scrollbar { width: 10px; }
  .scroll-track::-webkit-scrollbar-track { background: #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb { background: #2a303b; border: 3px solid #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb:hover { background: #3c434f; }

  .view {
    position: relative;
    display: grid;
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 0;
    transition: grid-template-rows 0.5s ease-out;
  }
  /* view one: 90 / 10 at rest, 85 / 15 on hover — view two mirrored.
     Both tracks are `fr` (never `auto`): a transition to/from an `auto`
     track can't interpolate, which is what made the strip redraw
     top-to-bottom and fade on release. */
  .view-one { grid-template-rows: 9fr 1fr; }
  .view-two { grid-template-rows: 1fr 9fr; }
  /* the collapsed slice grows to ~15% of the view on hover */
  .view-one:has(.strip-dev:hover) { grid-template-rows: 17fr 3fr; }
  .view-two:has(.strip-pro:hover) { grid-template-rows: 3fr 17fr; }

  /* quiet entrance: everything rises into place, nothing sweeps across */
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .panel, .strip, .view-cta { animation: rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .view-two > * { animation-delay: 0.06s; }

  /* ── panels: scenery, not links ── */
  .panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    color: inherit;
  }
  .panel-pro { background: #0b0d10; }
  .panel-dev { background: #07080b; }

  /* Both views share one measure: full width inside the panel padding, so
     the ruled Pro blocks and the Personal card sit on the same inline box. */
  .panel-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0;
    height: 100%;
    padding: var(--s5) clamp(1rem, 4vw, 2.5rem);
  }

  /* ── band 1: identity ── */
  .identity {
    display: grid;
    /* tracks follow the content, not the type: the name column needs less
       than 7fr would claim, and the fact column less than 4fr leaves void */
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    align-items: start;
    width: 100%;
  }
  .identity-main { min-width: 0; }

  .split-name {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 800;
    /* `font-variation-settings` overrides `font-stretch` on the same axis, so
       the width axis is set in exactly one place. Declaring both left
       `font-stretch` silently dead and the tracking tuned for a cut the type
       never rendered at. */
    font-stretch: 78%;
    font-size: var(--t-display);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }
  .split-standfirst {
    margin-top: var(--s2);
    font-size: var(--t-deck);
    line-height: 1.5;
    /* light grey on a near-black ground needs a touch of tracking to hold
       its word shapes; the measure must clear 45ch */
    letter-spacing: 0.005em;
    color: #b9bfc9;
    max-width: 58ch;
  }

  /* contact doors sit with the name they belong to */
  .reach-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s4);
    margin-top: var(--s3);
  }
  .reach-link {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #a3abba;
    transition: color 0.2s ease;
  }
  .reach-link:hover { color: #c8a96a; }

  /* the fact table: the highest-value proof, sized to be read */
  .facts { margin: 0; min-width: 0; align-self: center; }
  .fact {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: var(--s3);
    padding: var(--s2) 0;
    border-bottom: 1px solid #262b34;
  }
  .fact:first-child { border-top: 1px solid #262b34; }
  .fact dt {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6d7482;
    padding-top: 0.18em;
  }
  .fact dd {
    margin: 0;
    font-size: var(--t-value);
    line-height: 1.4;
    color: #cfd4dc;
  }

  /* ── band 2: proof — the major break, then the ledger ── */
  .split-measure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin-top: var(--s7);
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
  }
  .metric { display: flex; gap: var(--s3); align-items: baseline; padding: var(--s2) var(--s4) var(--s2) 0; }
  .metric + .metric { border-left: 1px solid #262b34; padding-left: var(--s4); }
  .metric b {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 800;
    /* one axis, one declaration — see `.split-name` */
    font-stretch: 85%;
    font-size: var(--t-data);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .metric > span { font-size: var(--t-body); line-height: 1.3; color: #b9bfc9; }
  .metric i {
    display: block;
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-style: normal;
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8a96a;
    margin-top: var(--s1);
  }

  /* ── band 3: the rolling ledger ── */
  .ticker {
    width: 100%;
    margin-top: var(--s5);
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
    overflow: hidden;
    padding: var(--s2) 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .ticker-run {
    display: flex;
    width: max-content;
    animation: ticker-scroll 68s linear infinite;
  }
  .ticker:hover .ticker-run,
  .ticker:focus-within .ticker-run { animation-play-state: paused; }
  .ticker-set { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  .ticker-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s2);
    padding: 0 var(--s4);
    white-space: nowrap;
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-body);
    line-height: 1.6;
    color: #b6bdc9;
  }
  .ticker-item::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-left: var(--s4);
    border-radius: 50%;
    background: #3a414d;
    transform: translateY(-3px);
  }
  /* The key is the same face and the same size as its value — separation is
     carried by case, tracking and gold alone, which is why the tracking is
     wide and the weight steps up. A 1px size step would not read. */
  .ticker-item b {
    font-weight: 500;
    font-size: inherit;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── the door: last child of the panel, so it lands in the same place in
        both views instead of overlaying the strip in one and the panel in
        the other ── */
  .view-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
    margin-top: var(--s6);
    padding: var(--s3) var(--s5);
    text-decoration: none;
    color: #f2ede4;
    border: 1px solid #3a414d;
    transition: color 0.22s ease, border-color 0.22s ease, gap 0.22s ease;
  }
  .view-cta-label {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .view-cta svg { flex: none; transition: transform 0.22s ease; }
  .view-cta:hover { border-color: #c8a96a; gap: var(--s4); }
  .view-cta:hover svg { transform: translateX(3px); }
  .view-cta:focus-visible { outline: 2px solid #c8a96a; outline-offset: 3px; }

  /* ── the collapsed slice ── */
  .strip {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s1);
    min-height: 0;
    padding: var(--s3) clamp(1rem, 4vw, 2.5rem);
    overflow: hidden;
    text-align: center;
    background: #050609;
    border-top: 1px solid #23272f;
  }
  .strip-dev { border-top-color: #1c2a20; }
  .strip-pro { border-top-color: #2a2519; }
  .strip-bar {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(28rem, 62vw);
    height: 1px;
    transform: translateX(-50%) scaleX(0.6);
    transform-origin: center;
    background: currentColor;
    opacity: 0.28;
    /* transform, not width: the hairline grows without a layout pass */
    transition: opacity 0.28s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .strip-pro .strip-bar { color: #c8a96a; }
  .strip-dev .strip-bar { color: #42c0ff; }
  .strip:hover .strip-bar { opacity: 1; transform: translateX(-50%) scaleX(1); }

  .strip-face {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s3);
    flex-wrap: wrap;
    justify-content: center;
  }
  .strip-name {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: clamp(0.95rem, 1.7vw, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .strip-pro .strip-name {
    font-family: 'Archivo', 'Archivo Fallback', system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
  }
  .strip-path {
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: #6a7280;
  }
  .strip-hint {
    display: grid;
    grid-template-rows: 0fr;
    /* grid-rows, not max-height: the hint reveals without a layout pass on
       every frame and without hardcoding a line count */
    transition: grid-template-rows 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
    opacity: 0;
    transform: translateY(var(--s1));
  }
  .strip-hint > span {
    overflow: hidden;
    min-height: 0;
    font-family: 'IBM Plex Mono', 'Plex Mono Fallback', monospace;
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    color: #a3abba;
  }
  .strip:hover .strip-hint { grid-template-rows: 1fr; opacity: 1; transform: none; }

  /* ── Personal half: the fastfetch card ── */
  .dev-wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
