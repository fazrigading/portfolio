---
import '../styles/global.css';
import '../styles/pro.css';
import pro from '../data/pro.json';
import dev from '../data/dev.json';
import profile from '../data/profile.json';
import social from '../data/social.json';
import devWallpaper from '../assets/wallpapers/desktop/blue.webp';

const b = import.meta.env.BASE_URL;
const reach = social.socialLinks.filter((s) => s.name !== 'E-mail');
---

<!doctype html>
<html lang="en" data-zone="split" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.roles.join(', ')}. Two worlds: professional CV and research, and a personal terminal, game library and gallery.`}
    />
    <title>{profile.name} — Professional // Personal</title>
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        try {
          var z = localStorage.getItem('dedsec-zone');
          if (z) document.documentElement.dataset.lastZone = z;
        } catch {}
      })();
    </script>
    <style is:global>
      @font-face{font-family:"VT323";src:url("/fonts/VT323-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-800.woff2") format("woff2");font-weight:800;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var.woff2") format("woff2");font-weight:400 700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var-italic.woff2") format("woff2");font-weight:400 600;font-display:swap}
      @font-face{font-family:"Archivo";src:url("/fonts/Archivo-var.woff2") format("woff2");font-weight:400 800;font-stretch:62% 125%;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-500.woff2") format("woff2");font-weight:500;font-display:swap}
    </style>
  </head>

  <body class="split-body antialiased">
    <!-- ═══ the shared baseline: one rule both worlds obey ═══ -->
    <div class="zone-rail" id="zone-rail">
      <p class="split-eyebrow">{profile.name}<span class="gold"> — two worlds, one baseline</span></p>
      <div class="rail-links" role="group" aria-label="Choose a zone">
        <a href={`${b}pro`} data-jump="pro" class="rail-link">Professional<span class="rail-kicker">/pro</span></a>
        <a href={`${b}dev`} data-jump="dev" class="rail-link phos">Personal<span class="rail-kicker">/dev</span></a>
      </div>
    </div>

    <!-- ═══ two snapped viewports. One scroll moves between them. ═══ -->
    <div class="scroll-track" id="scroll-track">
      <span class="sr-only">Scroll down to move between the two worlds.</span>

      <!-- ══════ VIEW ONE — PROFESSIONAL dominant ══════ -->
      <section class="view view-one" aria-label="Professional">
        <a href={`${b}pro`} class="panel panel-pro panel-major" data-panel="pro" aria-label="Enter the Professional zone: CV, experience, research, contact">
          <span class="panel-inner">
            <span class="panel-grid">
              <span class="panel-col-left">
                <span class="split-name block">Fazri<br />Gading</span>
                <span class="split-standfirst block">
                  {profile.about.intro.split('. ').slice(0, 2).join('. ')}.
                </span>
              </span>
              <span class="panel-col-right">
                <span class="pro-rule-top block"></span>
                <span class="spec-list block">
                  <span class="spec-row"><span class="k">Role</span><span class="v">{profile.roles[0]} · {profile.roles[1]}</span></span>
                  <span class="spec-row"><span class="k">Org</span><span class="v">Mulawarman University</span></span>
                  <span class="spec-row"><span class="k">Since</span><span class="v">2023</span></span>
                  <span class="spec-row"><span class="k">Focus</span><span class="v">CV · LLM apps · RAG</span></span>
                </span>
              </span>
            </span>

            <span class="split-measure block">
              <span class="metric"><b>6</b><span>Scopus papers<i>2 in Q1</i></span></span>
              <span class="metric"><b>225+</b><span>Students taught<i>ML &amp; lab work</i></span></span>
              <span class="metric"><b>10</b><span>Shipped projects<i>Python · TS · Unity</i></span></span>
            </span>

            <span class="panel-cta">
              Check out my <span class="gold">Professional</span> Portfolio
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>

            <span class="reach-row">
              <a href={pro.contact.primary.href} class="reach-cta">
                Contact me
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </a>
              <span class="reach-rest">
                <a href={pro.contact.primary.href} class="reach-link">{pro.contact.primary.value}</a>
                {reach.map((s) => (
                  <a href={s.href} target="_blank" rel="noreferrer" class="reach-link">{s.name}</a>
                ))}
              </span>
            </span>
          </span>
        </a>

        <!-- the collapsed slice: an invitation, not a door -->
        <div class="strip strip-dev">
          <span class="strip-bar" aria-hidden="true"></span>
          <span class="strip-face">
            <span class="strip-name phos">Personal</span>
            <span class="strip-path">/dev</span>
          </span>
          <span class="strip-hint" aria-hidden="true">Scroll Down to see my Personal portfolio</span>
        </div>
      </section>

      <!-- ══════ VIEW TWO — PERSONAL dominant ══════ -->
      <section class="view view-two" aria-label="Personal">
        <div class="strip strip-pro">
          <span class="strip-bar" aria-hidden="true"></span>
          <span class="strip-face">
            <span class="strip-name gold">Professional</span>
            <span class="strip-path">/pro</span>
          </span>
          <span class="strip-hint" aria-hidden="true">Scroll Up to see my Professional portfolio</span>
        </div>

        <a href={`${b}dev`} class="panel panel-dev panel-major" data-panel="dev" aria-label="Enter the Personal zone: terminal, game library, gallery">
          <span class="dev-wall" aria-hidden="true"></span>
          <span class="panel-inner">
            <!-- fastfetch: mark on the left, machine readout on the right -->
            <div class="fastfetch">
              <pre class="ff-logo" aria-hidden="true">{dev.banner.join('\n')}</pre>
              <dl class="ff-rows">
                {dev.status.map((s) => (
                  <span class="ff-row"><dt>{s.k}</dt><dd>{s.v}</dd></span>
                ))}
              </dl>
            </div>

            <nav class="ff-hubs" aria-label="Personal sections">
              {dev.hubs.map((h) => (
                <a href={`${b}${h.href}`} class="ff-hub">{h.title}</a>
              ))}
            </nav>

            <span class="panel-cta">
              Check out my <span class="phos">Personal</span> Portfolio
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      </section>
    </div>
  </body>
</html>

<style>
  .split-body {
    margin: 0;
    background-color: #0b0d10;
    background-image: none;
    color: #f2ede4;
    font-family: 'Archivo', system-ui, sans-serif;
    /* the track scrolls, not the body */
    overflow: hidden;
  }

  /* ── the track: two snapped viewports, one scroll apart ── */
  .scroll-track {
    height: 200svh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }
  .scroll-track::-webkit-scrollbar { display: none; }

  .view {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: grid;
    min-height: 0;
    padding-top: 2.6rem;
    transition: grid-template-rows 0.62s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* view one: 80 / 20 — view two: 20 / 80 */
  .view-one { grid-template-rows: 4fr 1fr; }
  .view-two { grid-template-rows: 1fr 4fr; }
  /* the collapsed 20% slice grows to 30% on hover, revealing its hint */
  .view-one:has(.strip-dev:hover) { grid-template-rows: 7fr 3fr; }
  .view-two:has(.strip-pro:hover) { grid-template-rows: 3fr 7fr; }

  /* quiet entrance: panels rise into place, nothing sweeps across */
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .panel, .strip { animation: rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .view-two > * { animation-delay: 0.06s; }

  /* ── zone rail: one line, above everything ── */
  .zone-rail {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem clamp(1rem, 4vw, 2.5rem);
  }
  .rail-links { display: flex; gap: 1.25rem; }
  .rail-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d94a2;
    text-decoration: none;
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .rail-link.phos:hover { color: #5dff9b; border-color: #5dff9b; }
  .rail-link:hover { color: #c8a96a; border-color: #c8a96a; }
  .rail-kicker { font-size: 0.625rem; opacity: 0.55; }

  /* ── panels ── */
  .panel {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    outline: none;
  }
  .panel-pro { background: #0b0d10; color: #f2ede4; }
  .panel-dev { background: #07080b; color: #f2ede4; }
  .panel:focus-visible { box-shadow: inset 0 0 0 2px currentColor; }
  .panel-pro:focus-visible { box-shadow: inset 0 0 0 2px #c8a96a; }
  .panel-dev:focus-visible { box-shadow: inset 0 0 0 2px #5dff9b; }

  .panel-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(1.1rem, 2.6vh, 2rem);
    height: 100%;
    padding: clamp(1rem, 2.6vh, 1.6rem) clamp(1rem, 4vw, 2.5rem) clamp(1.6rem, 4vh, 2.6rem);
  }
  .panel-inner > * { max-width: 100%; }

  .panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    width: 100%;
  }
  .panel-col-left { min-width: 0; }
  .panel-col-right { min-width: 0; }
  .block { display: block; }

  /* ── the collapsed slice ── */
  .strip {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 0;
    overflow: hidden;
    text-align: center;
    border-top: 1px solid #23272f;
    background: #050609;
  }
  .strip-dev { border-top-color: #1c2a20; }
  .strip-pro { border-top-color: #2a2519; }
  /* the hairline that grows on hover — the 20% → 30% read */
  .strip-bar {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(18rem, 40vw);
    height: 1px;
    transform: translateX(-50%);
    background: currentColor;
    opacity: 0.28;
    transition: opacity 0.28s ease, width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .strip-pro .strip-bar { color: #c8a96a; }
  .strip-dev .strip-bar { color: #5dff9b; }
  .strip:hover .strip-bar { opacity: 1; width: min(28rem, 62vw); }

  .strip-face {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .strip-name {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.8rem, 1.35vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .strip-pro .strip-name { font-family: 'Archivo', system-ui, sans-serif; font-weight: 700; letter-spacing: 0.02em; font-size: clamp(0.95rem, 1.6vw, 1.25rem); }
  .strip-path {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: #5c6373;
  }
  .strip-hint {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: #8d94a2;
    opacity: 0;
    max-height: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease;
  }
  .strip:hover .strip-hint { opacity: 1; max-height: 2.4rem; transform: none; }

  /* ── type ladder ── */
  .split-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8d94a2;
  }
  .split-eyebrow.gold, .gold { color: #c8a96a; }
  .split-eyebrow.phos, .phos { color: #5dff9b; }

  /* The split's Pro voice is the Pro zone's voice: Archivo, not Bodoni. */
  .split-name {
    display: block;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 800;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 78;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }
  .split-standfirst {
    margin-top: 0.9rem;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    line-height: 1.55;
    color: #b9bfc9;
    max-width: 46ch;
  }

  /* spec-sheet rows, ruled */
  .pro-rule-top { height: 1px; background: #262b34; }
  .spec-list { display: block; }
  .spec-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid #262b34;
  }
  .spec-row .k {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6d7482;
    padding-top: 0.2em;
  }
  .spec-row .v { font-size: 0.8rem; line-height: 1.35; color: #cfd4dc; }

  /* the metrics measure */
  .split-measure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
    width: 100%;
  }
  .metric { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.55rem 1.25rem 0.5rem 0; }
  .metric + .metric { border-left: 1px solid #262b34; padding-left: 1.25rem; }
  .metric b {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 800;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 85;
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .metric > span { font-size: 0.72rem; line-height: 1.3; color: #b9bfc9; }
  .metric i {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-style: normal;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8a96a;
    margin-top: 0.2rem;
  }

  /* the centred call to action — the middle of each panel */
  .panel-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1rem, 1.9vw, 1.45rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #f2ede4;
    transition: gap 0.24s ease, color 0.24s ease;
  }
  .panel-cta svg { transition: transform 0.24s ease; }
  .panel-major:hover .panel-cta { gap: 1.1rem; }
  .panel-major:hover .panel-cta svg { transform: translateX(3px); }

  /* reach row: the contact action and every other door on one line */
  .reach-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    width: 100%;
  }
  .reach-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #f2ede4;
    text-decoration: none;
    border-bottom: 1px solid #c8a96a;
    padding-bottom: 0.2rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .reach-cta:hover { color: #c8a96a; }
  .reach-rest { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.15rem; }
  .reach-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #8d94a2;
    transition: color 0.2s ease;
  }
  .reach-link:hover { color: #c8a96a; }

  /* ── Personal half: the fastfetch card ── */
  .dev-wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('{devWallpaper.src}');
    background-size: cover;
    background-position: center;
    opacity: 0.16;
    filter: saturate(0.7);
  }
  .fastfetch {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.6rem);
    align-items: center;
    width: 100%;
    max-width: 62rem;
    padding: clamp(0.9rem, 2.4vh, 1.6rem) clamp(1rem, 2.6vw, 2rem);
    border: 1px solid #23272f;
    background: rgba(5, 6, 9, 0.72);
  }
  .ff-logo {
    font-family: 'VT323', monospace;
    /* 63 glyphs must fit the mark column: size off the column, not the viewport */
    font-size: clamp(0.28rem, 0.5vw, 0.58rem);
    line-height: 1.02;
    color: #5dff9b;
    margin: 0;
    opacity: 0.85;
    white-space: pre;
  }
  .ff-rows { display: block; margin: 0; min-width: 0; }
  .ff-row {
    display: grid;
    grid-template-columns: minmax(4.5rem, 22%) 1fr;
    gap: 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid #1a1e25;
  }
  .ff-row:last-child { border-bottom: 0; }
  .ff-row dt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6f7a68;
    text-align: right;
    padding-top: 0.15em;
  }
  .ff-row dd {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.35;
    color: #d7f7e4;
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
  }

  .ff-hubs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 0.65rem; }
  .ff-hub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #7f8798;
    border: 1px solid #23272f;
    padding: 0.3rem 0.7rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ff-hub:hover { color: #5dff9b; border-color: #5dff9b; }

  /* ── narrow ── */
  @media (max-width: 780px) {
    .split-body { overflow: hidden; }
    .panel-grid { grid-template-columns: 1fr; gap: 0.9rem; }
    .panel-col-right { display: none; }
    .split-measure { grid-template-columns: 1fr; }
    .metric { padding: 0.35rem 0; }
    .metric + .metric { border-left: 0; border-top: 1px solid #262b34; padding-left: 0; }
    /* no hover on touch — the hint would never be readable */
    .strip-hint { display: none; }
    .fastfetch { grid-template-columns: 1fr; gap: 1rem; justify-items: center; }
    .ff-logo { font-size: 0.42rem; }
    .zone-rail > p { display: none; }
    .zone-rail { justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .strip { animation: none; }
    .view { transition: none; }
    .panel-cta, .panel-cta svg, .strip-bar, .strip-hint { transition: none; }
  }
</style>

<script>
  // One behaviour: the door the visitor walks through is remembered.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-jump]').forEach((a) => {
      if (a.dataset.bound) return;
      a.dataset.bound = '1';
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('dedsec-zone', a.dataset.jump === 'pro' ? 'pro' : 'dev');
        } catch {}
      });
    });
  });
</script>