---
import '../styles/global.css';
import '../styles/pro.css';
import pro from '../data/pro.json';
import dev from '../data/dev.json';
import profile from '../data/profile.json';
import social from '../data/social.json';
import learning from '../data/learning.json';
import { getCollection } from 'astro:content';
import devWallpaper from '../assets/wallpapers/desktop/blue.webp';

const b = import.meta.env.BASE_URL;
const reach = social.socialLinks.filter((s) => s.name !== 'E-mail');

const posts = (await getCollection('blog'))
  .sort((a, b2) => (a.data.date < b2.data.date ? 1 : -1))
  .slice(0, 3);
const certs = learning.filter((l) => l.type === 'Certification').slice(0, 6);

/* One rolling ledger of everything behind the Professional door: roles,
   certifications and the latest posts. Rendered twice and translated -50%
   so the loop has no visible seam. */
const ticker = [
  ...pro.roles.map((r) => ({ k: 'Experience', v: `${r.role} · ${r.org}` })),
  ...certs.map((c) => ({ k: 'Certified', v: `${c.title} · ${c.provider}` })),
  ...posts.map((p) => ({ k: 'Blog', v: p.data.title })),
];
---

<!doctype html>
<html lang="en" data-zone="split" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.roles.join(', ')}. Two worlds: professional CV and research, and a personal terminal, game library and gallery.`}
    />
    <title>{profile.name} — Professional // Personal</title>
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    <style is:global>
      @font-face{font-family:"VT323";src:url("/fonts/VT323-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Syne";src:url("/fonts/Syne-normal-800.woff2") format("woff2");font-weight:800;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"JetBrains Mono";src:url("/fonts/JetBrainsMono-normal-700.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var.woff2") format("woff2");font-weight:400 700;font-display:swap}
      @font-face{font-family:"Bodoni Moda";src:url("/fonts/BodoniModa-var-italic.woff2") format("woff2");font-weight:400 600;font-display:swap}
      @font-face{font-family:"Archivo";src:url("/fonts/Archivo-var.woff2") format("woff2");font-weight:400 800;font-stretch:62% 125%;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-400.woff2") format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"IBM Plex Mono";src:url("/fonts/IBMPlexMono-normal-500.woff2") format("woff2");font-weight:500;font-display:swap}
    </style>
  </head>

  <body class="split-body antialiased">
    <h1 class="sr-only">Fazri Gading — two worlds: Professional and Personal</h1>

    <!-- ═══ two snapped viewports. One scroll moves between them. ═══ -->
    <div class="scroll-track" id="scroll-track">
      <span class="sr-only">Scroll down to move between the two worlds.</span>

      <!-- ══════ VIEW ONE — PROFESSIONAL dominant ══════ -->
      <section class="view view-one" aria-label="Professional">
        <!-- The panel is scenery, not a door: only the CTA below navigates. -->
        <div class="panel panel-pro">
          <div class="panel-inner">
            <div class="panel-grid">
              <div class="panel-col-left">
                <h2 class="split-name">Fazri<br />Gading</h2>
                <p class="split-standfirst">
                  {profile.about.intro.split('. ').slice(0, 2).join('. ')}.
                </p>
              </div>
              <div class="panel-col-right">
                <span class="pro-rule-top"></span>
                <span class="spec-list">
                  <span class="spec-row"><span class="k">Role</span><span class="v">{profile.roles[0]} · {profile.roles[1]}</span></span>
                  <span class="spec-row"><span class="k">Org</span><span class="v">Mulawarman University</span></span>
                  <span class="spec-row"><span class="k">Since</span><span class="v">2023</span></span>
                  <span class="spec-row"><span class="k">Focus</span><span class="v">CV · LLM apps · RAG</span></span>
                </span>
              </div>
            </div>

            <div class="split-measure">
              <span class="metric"><b>6</b><span>Scopus papers<i>2 in Q1</i></span></span>
              <span class="metric"><b>225+</b><span>Students taught<i>ML &amp; lab work</i></span></span>
              <span class="metric"><b>10</b><span>Shipped projects<i>Python · TS · Unity</i></span></span>
            </div>

            <!-- every door out of the Professional world, inside the panel -->
            <nav class="reach-row" aria-label="Professional contact links">
              <a href={pro.contact.primary.href} class="reach-link">{pro.contact.primary.value}</a>
              {reach.map((s) => (
                <a href={s.href} target="_blank" rel="noreferrer" class="reach-link">{s.name}</a>
              ))}
            </nav>

            <!-- the rolling ledger: experience, certifications, writing -->
            <div class="ticker" aria-hidden="true">
              <div class="ticker-run">
                {[0, 1].map(() => (
                  <span class="ticker-set">
                    {ticker.map((t) => (
                      <span class="ticker-item">
                        <b class="gold">{t.k}</b>
                        {t.v}
                      </span>
                    ))}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- the collapsed slice: an invitation, not a door -->
        <div class="strip strip-dev">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name phos">Personal</span>
            <span class="strip-path">/dev</span>
          </span>
          <span class="strip-hint">Scroll Down to see my Personal portfolio</span>
        </div>

        <!-- the one real door, centred on the bottom edge of the view -->
        <a href={`${b}pro`} class="view-cta" data-jump="pro">
          <span class="view-cta-label">Check out my <span class="gold">Professional</span> Portfolio</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </section>

      <!-- ══════ VIEW TWO — PERSONAL dominant ══════ -->
      <section class="view view-two" aria-label="Personal">
        <div class="strip strip-pro">
          <span class="strip-bar"></span>
          <span class="strip-face">
            <span class="strip-name gold">Professional</span>
            <span class="strip-path">/pro</span>
          </span>
          <span class="strip-hint">Scroll Up to see my Professional portfolio</span>
        </div>

        <div class="panel panel-dev">
          <span class="dev-wall"></span>
          <div class="panel-inner">
            <!-- fastfetch: mark on the left, machine readout on the right -->
            <div class="fastfetch">
              <pre class="ff-logo">{dev.banner.join('\n')}</pre>
              <dl class="ff-rows">
                {dev.status.map((s) => (
                  <span class="ff-row"><dt>{s.k}</dt><dd>{s.v}</dd></span>
                ))}
              </dl>
            </div>

            <nav class="ff-hubs" aria-label="Personal sections">
              {dev.hubs.map((h) => (
                <a href={`${b}${h.href}`} class="ff-hub">{h.title}</a>
              ))}
            </nav>
          </div>
        </div>

        <a href={`${b}dev`} class="view-cta" data-jump="dev">
          <span class="view-cta-label">Check out my <span class="phos">Personal</span> Portfolio</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </section>
    </div>
  </body>
</html>

<style>
  .split-body {
    margin: 0;
    background-color: #0b0d10;
    background-image: none;
    color: #f2ede4;
    font-family: 'Archivo', system-ui, sans-serif;
  }

  /* ── the track: a viewport-tall scroller over two 100svh views ──
     Height must be ONE viewport, never the sum of its children: sizing the
     track to the total content height leaves nothing to scroll. `dvh` is
     deliberate — the track follows a mobile URL bar while the views stay on
     `svh`, so a shrinking bar cannot crop their content. */
  .scroll-track {
    height: 100dvh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: thin;
    scrollbar-color: #2a303b #0b0d10;
  }
  .scroll-track::-webkit-scrollbar { width: 10px; }
  .scroll-track::-webkit-scrollbar-track { background: #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb { background: #2a303b; border: 3px solid #0b0d10; }
  .scroll-track::-webkit-scrollbar-thumb:hover { background: #3c434f; }

  .view {
    position: relative;
    display: grid;
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 0;
    transition: grid-template-rows 0.62s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* view one: 80 / 20 — view two: 20 / 80. The slice track is `auto` at
     rest, so it holds the ~20% it was given instead of being clipped. */
  .view-one { grid-template-rows: 1fr auto; }
  .view-two { grid-template-rows: auto 1fr; }
  /* the collapsed slice grows to ~30% of the view on hover */
  .view-one:has(.strip-dev:hover) { grid-template-rows: 7fr 3fr; }
  .view-two:has(.strip-pro:hover) { grid-template-rows: 3fr 7fr; }

  /* quiet entrance: everything rises into place, nothing sweeps across */
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .panel, .strip, .view-cta { animation: rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .view-two > * { animation-delay: 0.06s; }

  /* ── panels: scenery, not links ── */
  .panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    color: inherit;
  }
  .panel-pro { background: #0b0d10; }
  .panel-dev { background: #07080b; }

  .panel-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(0.5rem, 1.4vh, 1rem);
    height: 100%;
    /* the bottom pad clears the CTA pinned to the view's edge */
    padding: 1.6rem clamp(1rem, 4vw, 2.5rem) clamp(3rem, 7vh, 4rem);
  }
  .panel-inner > * { max-width: 100%; }

  .panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    width: 100%;
  }
  .panel-col-left { min-width: 0; }
  .panel-col-right { min-width: 0; }

  /* ── the collapsed slice ── */
  .strip {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 0;
    padding: 1.1rem clamp(1rem, 4vw, 2.5rem);
    overflow: hidden;
    text-align: center;
    background: #050609;
    border-top: 1px solid #23272f;
  }
  .strip-dev { border-top-color: #1c2a20; }
  .strip-pro { border-top-color: #2a2519; }
  .strip-bar {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(18rem, 40vw);
    height: 1px;
    transform: translateX(-50%);
    background: currentColor;
    opacity: 0.28;
    transition: opacity 0.28s ease, width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .strip-pro .strip-bar { color: #c8a96a; }
  .strip-dev .strip-bar { color: #5dff9b; }
  .strip:hover .strip-bar { opacity: 1; width: min(28rem, 62vw); }

  .strip-face {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .strip-name {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.95rem, 1.7vw, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .strip-pro .strip-name {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
  }
  .strip-path {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: #5c6373;
  }
  .strip-hint {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #8d94a2;
    opacity: 0;
    max-height: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease;
  }
  .strip:hover .strip-hint { opacity: 1; max-height: 2.4rem; transform: none; }

  /* ── type ladder ── */
  .gold { color: #c8a96a; }
  .phos { color: #5dff9b; }

  /* The split's Pro voice is the Pro zone's voice: Archivo, not Bodoni. */
  .split-name {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 800;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 78;
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
  }
  .split-standfirst {
    margin-top: 0.75rem;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    line-height: 1.5;
    color: #b9bfc9;
    max-width: 46ch;
  }

  .pro-rule-top { display: block; height: 1px; background: #262b34; }
  .spec-list { display: block; }
  .spec-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.34rem 0;
    border-bottom: 1px solid #262b34;
  }
  .spec-row .k {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6d7482;
    padding-top: 0.2em;
  }
  .spec-row .v { font-size: 0.76rem; line-height: 1.35; color: #cfd4dc; }

  .split-measure {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
    width: 100%;
  }
  .metric { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.45rem 1.25rem 0.4rem 0; }
  .metric + .metric { border-left: 1px solid #262b34; padding-left: 1.25rem; }
  .metric b {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 800;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 85;
    font-size: clamp(1.3rem, 2.3vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .metric > span { font-size: 0.68rem; line-height: 1.3; color: #b9bfc9; }
  .metric i {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-style: normal;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8a96a;
    margin-top: 0.18rem;
  }

  /* every contact door, inside the panel */
  .reach-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.35rem;
    width: 100%;
  }
  .reach-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #8d94a2;
    transition: color 0.2s ease;
  }
  .reach-link:hover { color: #c8a96a; }

  /* ── the rolling ledger ── */
  .ticker {
    width: 100%;
    border-top: 1px solid #262b34;
    border-bottom: 1px solid #262b34;
    overflow: hidden;
    padding: 0.45rem 0;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .ticker-run {
    display: flex;
    width: max-content;
    animation: ticker-scroll 68s linear infinite;
  }
  .ticker:hover .ticker-run { animation-play-state: paused; }
  .ticker-set { display: flex; align-items: center; }
  .ticker-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0 1.35rem;
    white-space: nowrap;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: #9aa2b0;
  }
  .ticker-item::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-left: 1.35rem;
    border-radius: 50%;
    background: #3a414d;
    transform: translateY(-3px);
  }
  .ticker-item b {
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── the one door, centred on the bottom edge of each view ── */
  .view-cta {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 5;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1rem clamp(1.5rem, 6vw, 4rem);
    text-decoration: none;
    color: #f2ede4;
    background: #0b0d10;
    border: 1px solid #262b34;
    border-bottom: 0;
    white-space: nowrap;
    transition: color 0.22s ease, border-color 0.22s ease, gap 0.22s ease;
  }
  .view-two .view-cta { background: #07080b; }
  .view-cta-label {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .view-cta svg { transition: transform 0.22s ease; }
  .view-cta:hover { border-color: #c8a96a; gap: 1rem; }
  .view-cta:hover svg { transform: translateX(3px); }
  .view-cta:focus-visible { outline: 2px solid #c8a96a; outline-offset: 3px; }

  /* ── Personal half: the fastfetch card ── */
  .dev-wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('{devWallpaper.src}');
    background-size: cover;
    background-position: center;
    opacity: 0.16;
    filter: saturate(0.7);
  }
  .fastfetch {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.6rem);
    align-items: center;
    width: 100%;
    max-width: 62rem;
    padding: clamp(0.9rem, 2.4vh, 1.6rem) clamp(1rem, 2.6vw, 2rem);
    border: 1px solid #23272f;
    background: rgba(5, 6, 9, 0.72);
  }
  .ff-logo {
    font-family: 'VT323', monospace;
    font-size: clamp(0.28rem, 0.5vw, 0.58rem);
    line-height: 1.02;
    color: #5dff9b;
    margin: 0;
    opacity: 0.85;
    white-space: pre;
  }
  .ff-rows { display: block; margin: 0; min-width: 0; }
  .ff-row {
    display: grid;
    grid-template-columns: minmax(4.5rem, 22%) 1fr;
    gap: 1rem;
    padding: 0.28rem 0;
    border-bottom: 1px solid #1a1e25;
  }
  .ff-row:last-child { border-bottom: 0; }
  .ff-row dt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6f7a68;
    text-align: right;
    padding-top: 0.15em;
  }
  .ff-row dd {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.35;
    color: #d7f7e4;
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
  }

  .ff-hubs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 0.65rem; }
  .ff-hub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #7f8798;
    border: 1px solid #23272f;
    padding: 0.3rem 0.7rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ff-hub:hover { color: #5dff9b; border-color: #5dff9b; }

  /* ── narrow ── */
  @media (max-width: 780px) {
    .panel-grid { grid-template-columns: 1fr; gap: 0.8rem; }
    .panel-col-right { display: none; }
    .split-measure { grid-template-columns: 1fr; }
    .metric { padding: 0.28rem 0; }
    .metric + .metric { border-left: 0; border-top: 1px solid #262b34; padding-left: 0; }
    .strip-hint { display: none; }
    .fastfetch { grid-template-columns: 1fr; gap: 1rem; justify-items: center; }
    .ff-logo { font-size: 0.42rem; }
    .view-cta { padding: 0.8rem 1.25rem; }
    .ticker-item { padding: 0 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .strip, .view-cta { animation: none; }
    .view { transition: none; }
    .ticker-run { animation: none; }
    .view-cta, .view-cta svg, .strip-bar, .strip-hint { transition: none; }
  }
</style>

<script>
  // The door the visitor walks through is remembered for the redirect shims.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-jump]').forEach((a) => {
      if (a.dataset.bound) return;
      a.dataset.bound = '1';
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('dedsec-zone', a.dataset.jump === 'pro' ? 'pro' : 'dev');
        } catch {}
      });
    });
  });
</script>