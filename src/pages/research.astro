---
import Layout from '../layouts/Layout.astro';
import AsciiHeader from '../components/AsciiHeader.astro';
import RetroWindow from '../components/RetroWindow.astro';
import LucideIcon from '../components/LucideIcon.astro';
import research from '../data/research.json';

const RESEARCH_FILTERS = ['peer-reviewed', 'conference', 'community'];
const FILTER_LABELS: Record<string, string> = {
  'peer-reviewed': 'Peer-reviewed',
  conference: 'Conference',
  community: 'Community Service',
};
// Scopus journals = peer-reviewed, IEEE proceedings = conference, rest = community
const researchFilter = (r: { category: string }) => {
  if (r.category === 'Community Service') return 'community';
  if (/conference/i.test(r.category)) return 'conference';
  return 'peer-reviewed';
};
---

<Layout route="research" title="RESEARCH">
  <AsciiHeader title="ARCHIVE" tag="// ROUTE:/RESEARCH — STATIC LIST V1 (NODEGRAPH = V2)" />

  <div class="flex flex-wrap gap-2 pb-8" id="filter-matrix">
    <button data-filter="all" class="filter-btn border border-accent bg-accentsurface px-3 py-1.5 text-xs uppercase tracking-widest text-accent">ALL</button>
    {RESEARCH_FILTERS.map((f) => (
      <button data-filter={f} class="filter-btn border border-grid px-3 py-1.5 text-xs uppercase tracking-widest text-dim hover:border-accent hover:text-accent">{FILTER_LABELS[f]}</button>
    ))}
  </div>

  <div class="space-y-4" id="archive-grid">
    {research.map((r, i) => (
      <div class="archive-item" data-filter={researchFilter(r)}>
      <RetroWindow tag={r.status === 'Published' ? 'PEER_REVIEWED' : 'DRAFT'}>
        <div class="flex flex-col gap-4 sm:flex-row">
          <div class="flex min-w-0 flex-1 flex-col">
            <h3 class="glitch pb-2 font-punk text-base font-bold uppercase" data-text={r.title}>{r.title}</h3>
            <p class="text-xs uppercase tracking-widest text-dim">
              <span class="text-accent">[{String(i + 1).padStart(2, '0')}]</span> {r.authors}
            </p>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 text-xs uppercase tracking-widest">
              <span class="inline-flex items-center gap-1 text-accent">
                <LucideIcon name="BookOpen" size={12} />
                {r.journalUrl ? <a href={r.journalUrl} target="_blank" rel="noreferrer" class="hover:underline">{r.journal}</a> : r.journal}
              </span>
              <span class="inline-flex items-center gap-1 text-dim">
                <LucideIcon name="Calendar" size={12} />{r.year}
              </span>
              <span class="border border-grid px-1 text-dim">{r.category}</span>
            </p>
            <div class="flex flex-wrap gap-4 pt-2 text-xs uppercase tracking-widest">
              {r.articleUrl && <a href={r.articleUrl} target="_blank" rel="noreferrer" class="text-accent hover:underline">ARTICLE →</a>}
              {'repo' in r && (r as any).repo && <a href={(r as any).repo} target="_blank" rel="noreferrer" class="text-accent hover:underline">REPO →</a>}
              {'dataset_tags' in r && Array.isArray((r as any).dataset_tags) && (r as any).dataset_tags.map((d: string) => (
                <span class="border border-grid px-1.5 py-0.5 text-dim">{d}</span>
              ))}
            </div>
            {'abstract' in r && (r as any).abstract && (
              <p class="pt-2 text-xs leading-relaxed text-dim"><span class="text-accent">ABSTRACT // </span>{(r as any).abstract}</p>
            )}
          </div>
          <div class="flex aspect-[1/1.414] w-full shrink-0 flex-col items-center justify-center gap-2 overflow-hidden border border-grid bg-accentsurface sm:w-63" aria-hidden="true">
            <LucideIcon name="FileText" size={63} class="text-accent" />
            <span class="text-[10px] uppercase tracking-widest text-dim">A4 // NO_DOC</span>
          </div>
        </div>
      </RetroWindow>
      </div>
    ))}
  </div>
</Layout>

<script is:inline>
  function markActive(btns, btn) {
    btns.forEach((b) => {
      var on = b === btn;
      b.classList.toggle('border-accent', on);
      b.classList.toggle('bg-accentsurface', on);
      b.classList.toggle('text-accent', on);
      b.classList.toggle('border-grid', !on);
      b.classList.toggle('text-dim', !on);
    });
  }
  const btns = document.querySelectorAll('#filter-matrix .filter-btn');
  const items = document.querySelectorAll('#archive-grid .archive-item');
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.getAttribute('data-filter');
      markActive(btns, btn);
      items.forEach((it) => {
        it.style.display = f === 'all' || it.getAttribute('data-filter') === f ? '' : 'none';
      });
    });
  });
</script>
