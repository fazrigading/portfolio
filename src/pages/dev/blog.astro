---
import { getCollection } from 'astro:content';
import DevLayout from '../../layouts/DevLayout.astro';
import AsciiHeader from '../../components/AsciiHeader.astro';
import ZineCard from '../../components/ZineCard.astro';

const b = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort((a, b2) => (a.data.date < b2.data.date ? 1 : -1));
---

<DevLayout route="dev/blog" title="BROADCAST">
  <AsciiHeader title="BROADCAST" tag="// ROUTE:/DEV/BLOG — SHIKI-ENCODED TRANSMISSIONS" />

  {posts.length === 0 && (
    <ZineCard title="NO_SIGNAL">
      <p class="text-sm text-dim">No transmissions yet. Check back on this frequency.</p>
    </ZineCard>
  )}

  <div class="space-y-4">
    {posts.map((p, i) => (
      <a href={`${b}dev/blog/${p.data.slug}`} class="block">
        <ZineCard title={p.data.title}>
          <p class="pt-1 font-display text-sm tracking-widest text-accent">
            <span class="text-dim">{String(posts.length - i).padStart(3, '0')}</span> // {p.data.date}
          </p>
          <p class="pt-2 text-[13px] leading-relaxed text-dim">{p.data.excerpt}</p>
          <div class="flex gap-1.5 pt-2">
            {p.data.tags.map((t) => (
              <span class="border border-grid px-1.5 py-0.5 text-[11px] text-dim">#{t}</span>
            ))}
          </div>
        </ZineCard>
      </a>
    ))}
  </div>
</DevLayout>