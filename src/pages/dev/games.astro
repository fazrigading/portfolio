---
import DevLayout from '../../layouts/DevLayout.astro';
import GameCover from '../../components/GameCover.astro';
import showcase from '../../data/showcase.json';
import social from '../../data/social.json';

const b = import.meta.env.BASE_URL;

const sections = [
  { key: 'nowPlaying', label: 'NOW PLAYING', games: showcase.gaming.nowPlaying },
  { key: 'liked', label: 'BACKLOG — FINISHED', games: showcase.gaming.likedGames },
  { key: 'want', label: 'BACKLOG — QUEUED', games: showcase.gaming.wantToPlay },
];
const all = sections.flatMap((s) => s.games);
const genres = [...new Set(all.flatMap((g) => g.genres ?? []))].sort();
const stores = social.gaming;
---

<DevLayout route="dev/games" title="LIBRARY">
  <div class="pt-12">
    <p class="font-display text-sm tracking-widest text-accent">// LIBRARY_INDEX — {all.length} GAMES</p>
    <h1 class="glitch ascii-title font-display uppercase text-ink" data-text="The Library">The Library</h1>
    <p class="max-w-prose pt-3 text-sm leading-relaxed text-dim">
      Every game I have played, on the shelf. Hover a cover for the note I wrote about it. Includes the Watch
      Dogs games — the reason this half of the site exists.
    </p>
  </div>

  <!-- genre filter: real <details> disclosure, no island -->
  <details class="mt-8 border border-grid bg-void/70">
    <summary class="flex cursor-pointer items-center gap-2 px-3 py-2 text-[11px] uppercase tracking-widest text-dim hover:text-accent">
      <span class="text-accent">▸</span> FILTER_BY_GENRE — {genres.length} TAGS
    </summary>
    <div class="flex flex-wrap gap-x-4 gap-y-1.5 border-t border-grid px-3 py-3">
      {genres.map((g) => (
        <button
          type="button"
          data-genre={g}
          aria-pressed="false"
          class="genre-chip border border-grid px-2 py-0.5 text-[11px] uppercase tracking-wider text-dim transition-colors hover:border-accent hover:text-accent"
        >
          {g}
        </button>
      ))}
      <button type="button" data-genre-clear class="ml-auto text-[11px] uppercase tracking-wider text-accent hover:underline">
        clear ✕
      </button>
    </div>
  </details>

  {
    sections.map((s) => (
      <section class="pt-14">
        <div class="flex items-baseline justify-between gap-4 border-b border-grid pb-2">
          <h2 class="font-punk text-base font-bold uppercase text-ink">{s.label}</h2>
          <span class="text-xs text-dim" data-count>{s.games.length}</span>
        </div>
        <div class="grid grid-cols-3 gap-3 pt-5 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8" data-shelf={s.key}>
          {s.games.map((g) => (
            <div data-genres={(g.genres ?? []).join('|')}>
              <GameCover game={g} base={b} />
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <div class="pt-16">
    <p class="font-display text-sm tracking-widest text-accent">// STOREFRONTS</p>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-wider">
      {stores.map((s) => (
        <a href={s.href} target="_blank" rel="noreferrer" class="text-dim transition-colors hover:text-accent">{s.name}</a>
      ))}
    </div>
  </div>
</DevLayout>

<script is:inline>
  // Genre filter: one selected tag at a time, no framework.
  function bindGenreFilter() {
    var wrap = document.querySelector('[data-genre-clear]');
    if (!wrap || wrap.dataset.bound) return;
    wrap.dataset.bound = '1';
    var chips = document.querySelectorAll('[data-genre]');
    var apply = function (sel) {
      chips.forEach(function (c) {
        c.setAttribute('aria-pressed', String(c.getAttribute('data-genre') === sel));
        c.classList.toggle('border-accent', c.getAttribute('data-genre') === sel);
        c.classList.toggle('text-accent', c.getAttribute('data-genre') === sel);
      });
      document.querySelectorAll('[data-shelf] [data-genres]').forEach(function (item) {
        var list = (item.getAttribute('data-genres') || '').split('|');
        var on = !sel || list.indexOf(sel) !== -1;
        item.style.display = on ? '' : 'none';
      });
      document.querySelectorAll('[data-shelf]').forEach(function (shelf) {
        var n = shelf.querySelectorAll('[data-genres]:not([style*="display: none"])').length;
        var out = shelf.parentElement.querySelector('[data-count]');
        if (out) out.textContent = n;
      });
    };
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        var sel = c.getAttribute('data-genre');
        apply(c.getAttribute('aria-pressed') === 'true' ? null : sel);
      });
    });
    wrap.addEventListener('click', function () {
      apply(null);
    });
  }
  document.addEventListener('astro:page-load', bindGenreFilter);
  bindGenreFilter();
</script>