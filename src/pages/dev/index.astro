---
import DevLayout from '../../layouts/DevLayout.astro';
import ZineCard from '../../components/ZineCard.astro';
import TerminalHero from '../../components/TerminalHero.tsx';
import dev from '../../data/dev.json';
import showcase from '../../data/showcase.json';
import profile from '../../data/profile.json';

const b = import.meta.env.BASE_URL;
const games = showcase.gaming.nowPlaying.length + showcase.gaming.likedGames.length + showcase.gaming.wantToPlay.length;
const gallery = showcase.gallery.nature.length + showcase.gallery.objects.length;
---

<DevLayout route="dev" title="PERSONAL HUB">
  <div class="grid gap-8 pt-12 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-7">
      <pre class="overflow-x-auto pb-2 font-display text-accent" style="font-size: clamp(0.42rem, 1.5vw, 0.95rem); line-height: 1.05;" aria-label="DEDSEC">{dev.banner2.join('\n')}</pre>
      <h1 class="glitch ascii-title font-display uppercase text-ink" data-text={profile.name}>{profile.name}</h1>
      <p class="max-w-prose pt-4 text-sm leading-relaxed text-dim">{dev.about}</p>
    </div>

    <div class="md:col-span-5">
      <p class="font-display text-sm tracking-widest text-accent">SYS.INFO_</p>
      <dl class="card mt-3 divide-y divide-grid">
        {dev.status.map((s) => (
          <div class="flex items-baseline justify-between gap-3 px-3 py-2">
            <dt class="text-[11px] uppercase tracking-widest text-dim">{s.k}</dt>
            <dd class="text-right text-xs text-ink">{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="pt-14">
    <TerminalHero client:load />
  </div>

  <div class="grid gap-6 pt-14 md:grid-cols-2">
    {dev.hubs.map((h) => (
      <ZineCard title={h.title} tag={h.kicker}>
        <p class="pt-2 text-xs leading-relaxed text-dim">{h.body}</p>
        <div class="pt-4 text-xs uppercase tracking-widest">
          <a href={b + h.href} class="text-accent hover:underline">OPEN →</a>
        </div>
      </ZineCard>
    ))}
  </div>

  <p class="pt-14 text-center text-xs uppercase tracking-widest text-dim">
    Games indexed: {games} · Gallery slots: {gallery} · <a href={`${b}pro`} class="text-accent hover:underline">← PROFESSIONAL SIDE</a>
  </p>
</DevLayout>
