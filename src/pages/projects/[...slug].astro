---
import { getCollection } from 'astro:content';
import ZoneRedirect from '../../components/ZoneRedirect.astro';
import { slugify } from '../../components/slug';
import projects from '../../data/projects.json';

// Enumerate every slug the zone-owned pages already generate, so each old
// detail URL resolves to the matching one in the visitor's zone.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return [
    ...projects.map((p) => ({ params: { slug: slugify(p.title) } })),
    ...posts.map((p) => ({ params: { slug: p.data.slug } })),
  ];
}

const { slug } = Astro.params as { slug: string };
const isProject = projects.some((p) => slugify(p.title) === slug);
---

<ZoneRedirect kind={isProject ? 'projects' : 'blog'} slug={slug} />
